// Per-tool allow/ask/deny editor: ToolPolicyRowItem + ToolPolicyTable.
// Shared by the Servers tab and the Add Server wizard to set each tool's policy.
// Pure markup over ToolPolicyRow; emits change-decision(tool, decision).

import { Theme } from "../theme.slint";
import { PolicySelector, PillButton } from "primitives.slint";
import { ToolPolicyRow } from "../structs.slint";

export component ToolPolicyRowItem inherits Rectangle {
    in property <string> name;
    in property <string> description;
    in property <string> decision;
    property <bool> expanded: false;
    callback change-decision(string);
    background: Theme.surface;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: Theme.gap-sm;
        spacing: 4px;
        HorizontalLayout {
            spacing: Theme.gap-md;
            alignment: space-between;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                ta := TouchArea {
                    clicked => { root.expanded = !root.expanded; }
                    Text {
                        text: root.name;
                        color: Theme.text-primary;
                        font-size: Theme.font-body-sm;
                    }
                }
            }
            PolicySelector {
                decision: root.decision;
                change-decision(d) => { root.change-decision(d); }
            }
        }
        if root.description != "" : Text {
            text: root.description;
            color: Theme.text-tertiary;
            font-size: Theme.font-body-sm;
            wrap: word-wrap;
            overflow: elide;
            height: root.expanded ? self.preferred-height : 32px;
        }
        if root.description != "" : Rectangle {
            height: 16px;
            background: transparent;
            TouchArea {
                clicked => { root.expanded = !root.expanded; }
                Text {
                    text: root.expanded ? "Show less ▴" : "Show more ▾";
                    color: Theme.accent;
                    font-size: Theme.font-body-sm;
                }
            }
        }
    }
}


export component ToolPolicyTable inherits Rectangle {
    in property <[ToolPolicyRow]> rows;
    in property <length> list-max-height: 360px;
    in property <bool> cap-height: true;
    callback change-decision(string, string);
    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: Theme.gap-sm;
            alignment: end;
            Text {
                text: "Set all:";
                color: Theme.text-tertiary;
                font-size: Theme.font-body-sm;
                vertical-alignment: center;
            }
            PillButton {
                label: "🟢";
                clicked => { root.change-decision("*", "allow"); }
            }
            PillButton {
                label: "🟡";
                clicked => { root.change-decision("*", "ask"); }
            }
            PillButton {
                label: "🔴";
                clicked => { root.change-decision("*", "deny"); }
            }
        }
        Flickable {
            height: root.cap-height
                ? min(root.list-max-height, content-layout.preferred-height)
                : content-layout.preferred-height;
            viewport-height: content-layout.preferred-height;
            content-layout := VerticalLayout {
                spacing: 6px;
                for tool in rows : ToolPolicyRowItem {
                    name: tool.name;
                    description: tool.description;
                    decision: tool.decision;
                    change-decision(d) => { root.change-decision(tool.name, d); }
                }
            }
        }
    }
}
