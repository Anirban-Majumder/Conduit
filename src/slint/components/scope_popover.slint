// Scope popover (§8a): per-editor scope management shared by the Server detail
// and the Skill detail. Lists Global + every known repo as a toggle, lets the
// user add a repo by typing a path (validated in Rust on Add), remove a single
// scope (✕), or "Remove from all". Rust owns the `scopes` model + add-path/error;
// every action is a callback wired in main.slint to the worker.

import { Theme } from "../theme.slint";
import { PillButton } from "../components/primitives.slint";
import { ModalShell } from "../components/modal.slint";
import { ScopeRow } from "../structs.slint";

export component ScopePopover inherits ModalShell {
    in property <string> editor-label;
    in property <string> item-label;
    in property <[ScopeRow]> scopes;
    in property <string> add-path;
    in property <string> add-error;
    callback toggle-scope(string, bool);   // scope-key, on
    callback add-repo(string);             // typed path
    callback remove-scope(string);         // scope-key
    callback remove-all();
    callback edit-add-path(string);
    title: root.editor-label + " · " + root.item-label;

    VerticalLayout {
        spacing: Theme.gap-sm;

        for s in root.scopes : Rectangle {
            height: 38px;
            background: Theme.surface-2;
            border-radius: Theme.radius-md;
            HorizontalLayout {
                padding-left: Theme.gap-sm;
                padding-right: Theme.gap-sm;
                spacing: Theme.gap-sm;
                check := Rectangle {
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: s.active ? Theme.accent : Theme.border-strong;
                    background: s.active ? Theme.accent : transparent;
                    Text {
                        text: s.active ? "✓" : "";
                        color: Theme.on-accent;
                        font-size: Theme.font-body-sm;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.toggle-scope(s.scope-key, !s.active); } }
                }
                Text {
                    text: s.label;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    font-family: "Space Mono";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if s.removable : rm := TouchArea {
                    width: 22px;
                    clicked => { root.remove-scope(s.scope-key); }
                    Text {
                        text: "✕";
                        color: rm.has-hover ? Theme.danger : Theme.text-tertiary;
                        font-size: Theme.font-body;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { background: Theme.border; height: 1px; }

        HorizontalLayout {
            spacing: Theme.gap-sm;
            Rectangle {
                background: Theme.surface-2;
                border-radius: Theme.radius-input;
                height: 34px;
                horizontal-stretch: 1;
                border-width: 1px;
                border-color: Theme.border;
                addinput := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    y: (parent.height - self.preferred-height) / 2;
                    text: root.add-path;
                    color: Theme.text-primary;
                    font-size: Theme.font-body-sm;
                    font-family: "Space Mono";
                    single-line: true;
                    edited => { root.edit-add-path(self.text); }
                    accepted => { root.add-repo(self.text); }
                }
                if root.add-path == "" : Text {
                    x: 10px;
                    text: "add repo: type a path…";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                    vertical-alignment: center;
                }
            }
            PillButton {
                label: "Add";
                bg-color: Theme.accent;
                fg-color: Theme.on-accent;
                clicked => { root.add-repo(addinput.text); }
            }
        }

        if root.add-error != "" : Text {
            text: root.add-error;
            color: Theme.danger;
            font-size: Theme.font-body-sm;
            wrap: word-wrap;
        }

        Rectangle { height: 4px; }
        PillButton {
            label: "Remove from all";
            outline: true;
            bg-color: transparent;
            clicked => { root.remove-all(); }
        }
    }
}
