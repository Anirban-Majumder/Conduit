// Settings tab: editable startup + default-policy toggles, plus a read-only
// mirror of the user's config.toml values. Editable settings round-trip through
// Rust callbacks; the config.toml block is display-only.
// Instantiated by main.slint when the Settings tab is active.

import { Theme } from "../theme.slint";
import { PolicySelector, SettingLine } from "../components/primitives.slint";
import { SettingsRow } from "../structs.slint";

export component SettingsTab inherits Rectangle {
    in property <SettingsRow> data;
    in property <bool> open-window-at-startup;
    in property <string> default-unknown-tool-policy;
    callback toggle-open-window(bool);
    callback set-default-policy(string);

    VerticalLayout {
        spacing: Theme.gap-md;

        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.gap-md;
                spacing: Theme.gap-sm;
                Text {
                    text: "Startup";
                    color: Theme.text-secondary;
                    font-size: Theme.font-eyebrow;
                }
                Rectangle {
                    background: transparent;
                    min-height: 32px;
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        alignment: start;
                        Rectangle {
                            background: root.open-window-at-startup ? Theme.accent : Theme.surface-3;
                            border-radius: 4px;
                            width: 18px;
                            height: 18px;
                            Text {
                                text: root.open-window-at-startup ? "✓" : "";
                                color: Theme.bg;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ta := TouchArea {
                                clicked => {
                                    root.toggle-open-window(!root.open-window-at-startup);
                                }
                            }
                        }
                        Text {
                            text: "Open window when daemon starts";
                            color: Theme.text-primary;
                            font-size: Theme.font-body-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.gap-md;
                spacing: Theme.gap-sm;
                Text {
                    text: "When an unknown tool is called";
                    color: Theme.text-secondary;
                    font-size: Theme.font-eyebrow;
                }
                PolicySelector {
                    decision: root.default-unknown-tool-policy;
                    change-decision(d) => { root.set-default-policy(d); }
                }
            }
        }

        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.gap-md;
                spacing: 4px;
                Text {
                    text: "From config.toml (read-only)";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-eyebrow;
                }
                SettingLine { label: "daemon.port"; value: root.data.port; }
                SettingLine { label: "daemon.approval_timeout_seconds"; value: root.data.approval_timeout; }
                SettingLine { label: "daemon.default_lifecycle_seconds"; value: root.data.default_lifecycle; }
                SettingLine { label: "daemon.audit_retention_days"; value: root.data.audit_retention; }
                SettingLine { label: "daemon.autostart_at_login"; value: root.data.autostart_at_login; }
                SettingLine { label: "gui.theme"; value: root.data.theme; }
                SettingLine { label: "notifications.enabled"; value: root.data.notifications_enabled; }
                SettingLine { label: "skills.sync_mode"; value: root.data.skills_sync_mode; }
            }
        }
    }
}

