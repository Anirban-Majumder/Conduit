// Servers tab: master/detail view of configured MCP servers (docs/DESIGN.md
// mockup). Left = server cards; right = detail header (Re-test/Edit/Delete),
// Health + Connected Editors cards, and the per-tool policy table.
// TargetToggle is the shared on/off chip, also reused by the Skills tab.

import { Theme } from "../theme.slint";
import { PillButton, StatusDot, Icon, Chip, IconToggle } from "../components/primitives.slint";
import { ServerDetail, IdeTarget, ServerRow, ToolPolicyRow } from "../structs.slint";
import { ToolPolicyTable } from "../components/tool_policy.slint";

// Shared on/off chip: mint (active) when the server/skill is enabled for that
// IDE, outlined+muted when not. Used by the Servers tab and the Skills tab.
export component TargetToggle inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback toggle();
    background: root.active ? Theme.accent-tint : transparent;
    border-radius: Theme.radius-pill;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    height: 32px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.text-secondary;
            font-size: Theme.font-body-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.toggle(); } }
}

component GlassPanel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
}

// Rounded-square icon badge used in the server cards + detail header.
component IconBadge inherits Rectangle {
    in property <length> box: 44px;
    width: root.box;
    height: root.box;
    background: Theme.surface-3;
    border-radius: Theme.radius-md;
    Icon {
        source: @image-url("../../../assets/icons/server.svg");
        tint: Theme.text-secondary;
        size: root.box * 0.5;
    }
}

component HealthCard inherits Rectangle {
    in property <ServerDetail> detail;
    callback copy-error();
    background: Theme.surface-2;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: Theme.gap-md;
        spacing: Theme.gap-sm;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Icon {
                source: @image-url("../../../assets/icons/activity.svg");
                tint: Theme.text-tertiary;
                size: 14px;
            }
            Text {
                text: "HEALTH STATUS";
                color: Theme.text-tertiary;
                font-size: Theme.font-eyebrow;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: Theme.gap-sm;
            alignment: start;
            VerticalLayout {
                alignment: center;
                StatusDot {
                    tint: detail.health-state == "live" ? Theme.success
                         : detail.health-state == "needsauth" ? Theme.warning
                         : detail.health-state == "down" ? Theme.danger
                         : detail.health-state == "probing" ? Theme.accent
                         : Theme.text-tertiary;
                }
            }
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: detail.health-state == "live" ? "Connected & Healthy"
                         : detail.health-state == "idle" ? "Idle"
                         : detail.health-state == "needsauth" ? "Needs sign-in"
                         : detail.health-state == "down" ? "Down"
                         : detail.health-state == "unprobed" ? "Unprobed"
                         : detail.health-state == "probing" ? "Re-testing…"
                         : detail.health-state;
                    color: Theme.text-primary;
                    font-size: Theme.font-body-lg;
                    font-weight: 600;
                }
                Text {
                    text: detail.latency-label != ""
                        ? "Last probe: " + detail.last-probe-label + " · Latency: " + detail.latency-label
                        : "Last probe: " + detail.last-probe-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                }
            }
        }
        if detail.last-error != "" : Text {
            text: detail.last-error;
            color: Theme.danger;
            font-size: Theme.font-body-sm;
            wrap: word-wrap;
        }
        if detail.last-error != "" : HorizontalLayout {
            alignment: start;
            PillButton {
                label: "Copy error";
                outline: true;
                bg-color: transparent;
                clicked => { root.copy-error(); }
            }
        }
    }
}

export component ServersTab inherits Rectangle {
    in property <[ServerRow]> rows;
    in property <string> selected;
    in property <ServerDetail> detail;
    in property <[ToolPolicyRow]> tools;
    in property <[IdeTarget]> targets;
    callback select-server(string);
    callback delete-clicked(string);
    callback retest-clicked(string);
    callback edit-clicked(string);
    callback change-tool-policy(string, string, string);
    callback toggle-target(string, string, bool);
    callback open-scope(string, string);   // server, ide_kind
    callback add-clicked();
    callback copy-error-clicked(string);

    HorizontalLayout {
        spacing: Theme.gap-lg;

        // Left: server list.
        VerticalLayout {
            width: 300px;
            spacing: Theme.gap-md;
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "MCP Servers";
                    color: Theme.text-primary;
                    font-size: Theme.font-headline-sm;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                PillButton {
                    label: "+ Add Server";
                    outline: true;
                    bg-color: transparent;
                    fg-color: Theme.accent;
                    clicked => { root.add-clicked(); }
                }
            }
            if rows.length == 0 : Text {
                text: "No MCP servers yet. Click Add Server to begin.";
                color: Theme.text-tertiary;
                font-size: Theme.font-body-sm;
                wrap: word-wrap;
            }
            Flickable {
                vertical-stretch: 1;
                viewport-height: srv-list.preferred-height;
                srv-list := VerticalLayout {
                    spacing: Theme.gap-sm;
                    for row in rows : Rectangle {
                        background: row.name == root.selected ? Theme.surface-2 : Theme.surface;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: row.name == root.selected ? Theme.accent : Theme.border;
                        height: 68px;
                        ta := TouchArea {
                            clicked => { root.select-server(row.name); }
                            HorizontalLayout {
                                padding: Theme.gap-sm;
                                spacing: Theme.gap-sm;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    IconBadge { box: 40px; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: row.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-body;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.auth_failure
                                            ? "needs auth · " + row.transport
                                            : row.tool_count_label + " · " + row.transport;
                                        color: row.auth_failure ? Theme.warning : Theme.text-tertiary;
                                        font-size: Theme.font-body-sm;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: start;
                                    StatusDot {
                                        tint: row.auth_failure ? Theme.warning : Theme.success;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 0; }
        }

        // Right: detail.
        GlassPanel {
            horizontal-stretch: 1;
            if root.selected == "" : VerticalLayout {
                alignment: center;
                Text {
                    text: "Select a server on the left, or click Add Server.";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                }
                Rectangle { vertical-stretch: 0; }
            }
            if root.selected != "" : VerticalLayout {
                Flickable {
                    vertical-stretch: 1;
                    viewport-height: detail-col.preferred-height;
                    detail-col := VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-lg;

                    HorizontalLayout {
                        spacing: Theme.gap-md;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: Theme.gap-md;
                            alignment: start;
                            IconBadge {}
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                HorizontalLayout {
                                    spacing: Theme.gap-sm;
                                    alignment: start;
                                    Text {
                                        text: detail.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-headline-sm;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    if detail.version != "" : VerticalLayout {
                                        alignment: center;
                                        Chip {
                                            label: detail.version;
                                            fg: Theme.text-secondary;
                                            bg: Theme.surface-3;
                                        }
                                    }
                                }
                                Text {
                                    text: detail.transport + " · " + detail.command-or-url;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-body-sm;
                                    overflow: elide;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.gap-sm;
                            alignment: center;
                            PillButton {
                                label: root.detail.health-state == "probing" ? "Re-testing…" : "Re-test";
                                enabled: root.detail.health-state != "probing";
                                outline: true;
                                bg-color: transparent;
                                fg-color: Theme.accent;
                                clicked => { root.retest-clicked(root.selected); }
                            }
                            PillButton {
                                label: "Edit";
                                outline: true;
                                bg-color: transparent;
                                clicked => { root.edit-clicked(root.selected); }
                            }
                            PillButton {
                                label: "Delete";
                                bg-color: Theme.danger-tint;
                                fg-color: Theme.danger;
                                clicked => { root.delete-clicked(root.selected); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.gap-md;
                        HealthCard {
                            detail: root.detail;
                            copy-error => { root.copy-error-clicked(root.detail.last-error); }
                        }
                        Rectangle {
                            background: Theme.surface-2;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border;
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: Theme.gap-md;
                                spacing: Theme.gap-sm;
                                Text {
                                    text: "CONNECTED EDITORS";
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-eyebrow;
                                    font-weight: 600;
                                }
                                if targets.length == 0 : Text {
                                    text: "No active editors detected.";
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-body-sm;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    for t in targets : IconToggle {
                                        source: t.icon;
                                        active: t.active;
                                        label: t.ide-kind;
                                        toggle => {
                                            root.open-scope(root.selected, t.ide-kind);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.detail.auth-failure-msg != "" : Rectangle {
                        background: Theme.danger-tint;
                        border-radius: Theme.radius-md;
                        min-height: 56px;
                        HorizontalLayout {
                            padding: Theme.gap-md;
                            spacing: Theme.gap-sm;
                            alignment: space-between;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Authentication failed";
                                    color: Theme.danger;
                                    font-size: Theme.font-body;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.detail.auth-failure-msg;
                                    color: Theme.danger;
                                    font-size: Theme.font-body-sm;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    label: "Edit";
                                    bg-color: Theme.accent;
                                    fg-color: Theme.on-accent;
                                    clicked => { root.edit-clicked(root.selected); }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Icon {
                            source: @image-url("../../../assets/icons/list-filter.svg");
                            tint: Theme.text-secondary;
                            size: 16px;
                        }
                        Text {
                            text: "Exposed Tools (" + tools.length + ")";
                            color: Theme.text-primary;
                            font-size: Theme.font-body-lg;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    if tools.length > 0 : ToolPolicyTable {
                        rows: root.tools;
                        cap-height: false;
                        change-decision(tool, decision) => {
                            root.change-tool-policy(root.selected, tool, decision);
                        }
                    }
                    if tools.length == 0 : Text {
                        text: "No tools discovered. Click Re-test.";
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                    }
                    }
                }
                Rectangle { vertical-stretch: 0; }
            }
        }
    }
}
