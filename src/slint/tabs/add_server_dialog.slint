// Add/Edit MCP Server wizard: connection form (step 1), probe + OAuth sign-in
// hold (step 2), and per-tool policy (step 3). Wrapped in ModalShell.
// The Arguments field doubles as a paste-to-autofill input (parse on edit).
// Env-var/header rows are backed by a Rust-owned model (env-* callbacks).

import { Theme } from "../theme.slint";
import { ModalShell, WizardStepIndicator } from "../components/modal.slint";
import { PillButton, Icon } from "../components/primitives.slint";
import { EnvVarRow, ToolPolicyRow } from "../structs.slint";
import { ToolPolicyTable } from "../components/tool_policy.slint";

component Seg inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked <=> ta.clicked;
    background: root.active ? Theme.surface-3 : transparent;
    border-radius: Theme.radius-pill;
    height: 30px;
    horizontal-stretch: 1;
    ta := TouchArea {
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            alignment: center;
            Text {
                text: root.label;
                color: root.active ? Theme.text-primary : Theme.text-tertiary;
                font-size: Theme.font-body-sm;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

component SegGroup inherits Rectangle {
    background: Theme.bg;
    border-radius: Theme.radius-pill;
    border-width: 1px;
    border-color: Theme.border;
    height: 36px;
}

component FieldLabel inherits Text {
    color: Theme.text-tertiary;
    font-size: Theme.font-eyebrow;
    font-weight: 600;
}

component FormInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> read-only: false;
    callback edited(string);
    background: Theme.bg;
    border-radius: Theme.radius-input;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    height: 44px;
    HorizontalLayout {
        padding-left: Theme.gap-md;
        padding-right: Theme.gap-md;
        input := TextInput {
            text <=> root.text;
            color: root.read-only ? Theme.text-tertiary : Theme.text-primary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            single-line: true;
            read-only: root.read-only;
            edited => { root.edited(self.text); }
        }
    }
    if root.text == "" && root.placeholder != "" : Text {
        x: Theme.gap-md;
        text: root.placeholder;
        color: Theme.text-tertiary;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }
}

export component AddServerDialog inherits Rectangle {
    in-out property <string> name;
    in-out property <string> command;
    in-out property <string> args;
    in-out property <string> url;
    in-out property <string> transport;
    in-out property <string> status;
    in-out property <bool> status-is-error: false;
    in-out property <bool> busy: false;
    in-out property <string> lifecycle-mode: "persistent";
    in-out property <string> lifecycle-custom: "300";
    in property <[EnvVarRow]> env-rows;
    in property <int> step;
    in property <string> phase-status;
    in property <string> oauth-url;
    in property <[ToolPolicyRow]> tools;
    in property <bool> edit-mode: false;
    callback start-probe();
    callback wizard-save();
    callback wizard-back();
    callback change-tool-policy(string, string);
    callback dismiss();
    callback parse();
    callback copy-oauth-url();
    callback env-add();
    callback env-remove(int);
    callback env-set-key(int, string);
    callback env-set-value(int, string);

    ModalShell {
        title: root.edit-mode ? "Edit MCP Server" : "Add MCP Server";
        dismiss => { root.dismiss(); }

        VerticalLayout {
            spacing: Theme.gap-lg;

            WizardStepIndicator { step: root.step; }

            if root.step == 1 : VerticalLayout {
                spacing: Theme.gap-md;

                HorizontalLayout {
                    spacing: Theme.gap-lg;
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "TRANSPORT TYPE"; }
                        SegGroup {
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 3px;
                                Seg {
                                    label: "Stdio";
                                    active: root.transport == "stdio";
                                    clicked => { root.transport = "stdio"; }
                                }
                                Seg {
                                    label: "HTTP / SSE";
                                    active: root.transport == "http";
                                    clicked => { root.transport = "http"; }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "LIFECYCLE"; }
                        SegGroup {
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 3px;
                                Seg {
                                    label: "Ephemeral";
                                    active: root.lifecycle-mode == "ephemeral";
                                    clicked => { root.lifecycle-mode = "ephemeral"; }
                                }
                                Seg {
                                    label: "Persistent";
                                    active: root.lifecycle-mode == "persistent";
                                    clicked => { root.lifecycle-mode = "persistent"; }
                                }
                                Seg {
                                    label: "Custom";
                                    active: root.lifecycle-mode == "custom";
                                    clicked => { root.lifecycle-mode = "custom"; }
                                }
                            }
                        }
                    }
                }

                if root.lifecycle-mode == "custom" : VerticalLayout {
                    spacing: 6px;
                    FieldLabel { text: "IDLE TTL (SECONDS)"; }
                    FormInput {
                        text <=> root.lifecycle-custom;
                        placeholder: "300";
                        edited(t) => { root.lifecycle-custom = t; }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    FieldLabel {
                        text: root.edit-mode ? "SERVER NAME (LOCKED)" : "SERVER NAME";
                    }
                    FormInput {
                        text <=> root.name;
                        placeholder: "e.g. postgres-readonly";
                        read-only: root.edit-mode;
                        edited(t) => { root.name = t; }
                    }
                }

                if root.transport == "stdio" : VerticalLayout {
                    spacing: 6px;
                    FieldLabel { text: "COMMAND"; }
                    FormInput {
                        text <=> root.command;
                        placeholder: "e.g. npx, docker, /usr/bin/python3";
                        edited(t) => { root.command = t; }
                    }
                }

                if root.transport == "http" : VerticalLayout {
                    spacing: 6px;
                    FieldLabel { text: "URL"; }
                    FormInput {
                        text <=> root.url;
                        placeholder: "https://mcp.example.com/sse";
                        edited(t) => { root.url = t; }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    FieldLabel {
                        text: root.transport == "stdio"
                            ? "ARGUMENTS (one per line, or paste full MCP JSON to autofill)"
                            : "ARGUMENTS / PASTE MCP JSON TO AUTOFILL";
                    }
                    Rectangle {
                        background: Theme.bg;
                        border-radius: Theme.radius-input;
                        border-width: 1px;
                        border-color: args-input.has-focus ? Theme.accent : Theme.border;
                        height: 96px;
                        args-input := TextInput {
                            x: Theme.gap-md;
                            y: Theme.gap-sm;
                            width: parent.width - 2 * Theme.gap-md;
                            height: parent.height - 2 * Theme.gap-sm;
                            text <=> root.args;
                            color: Theme.text-primary;
                            font-size: Theme.font-body-sm;
                            font-family: "Space Mono";
                            wrap: word-wrap;
                            single-line: false;
                            edited => {
                                parse-debounce.running = false;
                                parse-debounce.running = true;
                            }
                        }
                    }
                    parse-debounce := Timer {
                        interval: 500ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            root.parse();
                        }
                    }
                }

                // Environment variables / headers.
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: space-between;
                        FieldLabel {
                            text: root.transport == "http" ? "HEADERS" : "ENVIRONMENT VARIABLES";
                        }
                        addvar-ta := TouchArea {
                            width: 64px;
                            clicked => { root.env-add(); }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: end;
                                Icon {
                                    source: @image-url("../../../assets/icons/plus.svg");
                                    tint: Theme.accent;
                                    size: 14px;
                                }
                                Text {
                                    text: "Add";
                                    color: Theme.accent;
                                    font-size: Theme.font-body-sm;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    for row[i] in root.env-rows : HorizontalLayout {
                        spacing: Theme.gap-sm;
                        FormInput {
                            horizontal-stretch: 1;
                            text: row.key;
                            placeholder: "KEY";
                            edited(t) => { root.env-set-key(i, t); }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: "="; color: Theme.text-tertiary; font-size: Theme.font-body; }
                        }
                        FormInput {
                            horizontal-stretch: 1;
                            text: row.value;
                            placeholder: "value";
                            edited(t) => { root.env-set-value(i, t); }
                        }
                        rm-ta := TouchArea {
                            width: 32px;
                            clicked => { root.env-remove(i); }
                            Text {
                                text: "✕";
                                color: rm-ta.has-hover ? Theme.danger : Theme.text-tertiary;
                                font-size: Theme.font-body;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.status != "" : Rectangle {
                    background: root.status-is-error ? Theme.danger-tint : Theme.surface-2;
                    border-radius: Theme.radius-input;
                    min-height: 36px;
                    HorizontalLayout {
                        padding: Theme.gap-sm;
                        Text {
                            text: root.status;
                            color: root.status-is-error ? Theme.danger : Theme.text-secondary;
                            font-size: Theme.font-body-sm;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle { background: Theme.border; height: 1px; }
                HorizontalLayout {
                    alignment: space-between;
                    PillButton {
                        label: "Cancel";
                        bg-color: transparent;
                        fg-color: Theme.text-secondary;
                        clicked => { root.dismiss(); }
                    }
                    PillButton {
                        label: "Next Step  →";
                        bg-color: Theme.accent;
                        fg-color: Theme.on-accent;
                        clicked => { root.start-probe(); }
                    }
                }
            }

            if root.step == 2 && root.oauth-url == "" : VerticalLayout {
                spacing: Theme.gap-md;
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    alignment: start;
                    Text { text: "⟳"; font-size: 24px; color: Theme.accent; vertical-alignment: center; }
                    Text {
                        text: root.phase-status != "" ? root.phase-status : "Probing upstream...";
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "Spawning, calling initialize, fetching tools — up to ~30 seconds per phase.";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                    wrap: word-wrap;
                }
                if root.status != "" : Rectangle {
                    background: root.status-is-error ? Theme.danger-tint : Theme.surface-2;
                    border-radius: Theme.radius-input;
                    min-height: 32px;
                    HorizontalLayout {
                        padding: Theme.gap-sm;
                        Text {
                            text: root.status;
                            color: root.status-is-error ? Theme.danger : Theme.text-secondary;
                            font-size: Theme.font-body-sm;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    PillButton {
                        label: "← Back to edit";
                        outline: true;
                        bg-color: transparent;
                        clicked => { root.wizard-back(); }
                    }
                }
            }

            if root.step == 2 && root.oauth-url != "" : VerticalLayout {
                spacing: Theme.gap-md;
                Rectangle {
                    background: Theme.surface-2;
                    border-radius: Theme.radius-md;
                    min-height: 64px;
                    HorizontalLayout {
                        padding: Theme.gap-md;
                        spacing: Theme.gap-md;
                        Text { text: "🔐"; font-size: 28px; vertical-alignment: center; }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Sign in required";
                                color: Theme.text-primary;
                                font-size: Theme.font-h3;
                            }
                            Text {
                                text: "This server uses OAuth. We opened a browser tab — sign in and approve, then return here.";
                                color: Theme.text-secondary;
                                font-size: Theme.font-body-sm;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                Text {
                    text: "If the tab didn't open, copy this URL into your browser:";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                    wrap: word-wrap;
                }
                Rectangle {
                    background: Theme.surface-2;
                    border-radius: Theme.radius-input;
                    min-height: 36px;
                    HorizontalLayout {
                        padding: Theme.gap-sm;
                        spacing: Theme.gap-sm;
                        Text {
                            text: root.oauth-url;
                            color: Theme.text-primary;
                            font-size: Theme.font-body-sm;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        PillButton {
                            label: "Copy URL";
                            outline: true;
                            bg-color: transparent;
                            clicked => { root.copy-oauth-url(); }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    PillButton {
                        label: "← Back to edit";
                        outline: true;
                        bg-color: transparent;
                        clicked => { root.wizard-back(); }
                    }
                }
            }

            if root.step == 3 : VerticalLayout {
                spacing: Theme.gap-md;
                Text {
                    text: root.tools.length + " tools discovered. Default: Ask. Set Allow to auto-approve.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body-sm;
                    wrap: word-wrap;
                }
                ToolPolicyTable {
                    rows: root.tools;
                    change-decision(tool, decision) => { root.change-tool-policy(tool, decision); }
                }
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    alignment: end;
                    PillButton {
                        label: "← Back";
                        outline: true;
                        bg-color: transparent;
                        clicked => { root.wizard-back(); }
                    }
                    PillButton {
                        label: root.busy ? "Saving…" : "Save";
                        bg-color: root.busy ? Theme.surface-3 : Theme.accent;
                        fg-color: root.busy ? Theme.text-secondary : Theme.on-accent;
                        clicked => {
                            if (!root.busy) { root.wizard-save(); }
                        }
                    }
                }
            }
        }
    }
}
