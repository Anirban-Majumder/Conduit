// Bottom-right approvals popup: shows every pending tool-call request as a
// scrollable stack of cards. Replaces the old full-page Approvals tab — it only
// renders while approvals.length > 0 (placed behind that guard in main.slint).
// Each card expands to reveal the request body; emits approve / deny /
// approve-always back to the Rust glue.

import { Theme } from "../theme.slint";
import { PillButton, StatusDot } from "primitives.slint";
import { ApprovalRow } from "../structs.slint";

component ApprovalCard inherits Rectangle {
    in property <ApprovalRow> data;
    in property <bool> focused;
    property <bool> expanded: false;
    callback approve(string);
    callback deny(string);
    callback approve-always(string, string, string);

    background: Theme.surface-2;
    border-radius: Theme.radius-md;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.accent : Theme.border;

    VerticalLayout {
        padding: Theme.gap-sm;
        spacing: 6px;

        header := TouchArea {
            height: title-col.preferred-height;
            clicked => { root.expanded = !root.expanded; }
            HorizontalLayout {
                spacing: Theme.gap-sm;
                alignment: space-between;
                title-col := VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: root.data.server + " · " + root.data.tool;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        overflow: elide;
                    }
                    Text {
                        text: root.data.ide_name;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                        overflow: elide;
                    }
                }
                Text {
                    text: root.expanded ? "▴" : "▾";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
            }
        }

        if root.expanded : Rectangle {
            background: Theme.bg;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;
            height: min(160px, body-text.preferred-height + 16px);
            Flickable {
                viewport-height: body-text.preferred-height;
                body-text := Text {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    text: root.data.args_json == "" ? "(no arguments)" : root.data.args_json;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body-sm;
                    font-family: "Space Mono";
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap-sm;
            PillButton {
                label: "Approve";
                bg-color: Theme.accent;
                fg-color: Theme.bg;
                clicked => { root.approve(root.data.id); }
            }
            PillButton {
                label: "Deny";
                clicked => { root.deny(root.data.id); }
            }
        }
        TouchArea {
            height: 20px;
            clicked => {
                root.approve-always(root.data.id, root.data.server, root.data.tool);
            }
            Text {
                text: "✓ Approve always for this tool";
                color: Theme.accent;
                font-size: Theme.font-body-sm;
                horizontal-alignment: center;
            }
        }
    }
}

export component ApprovalsPopup inherits Rectangle {
    in property <[ApprovalRow]> rows;
    in property <string> focused-id;
    callback approve(string);
    callback deny(string);
    callback approve-always(string, string, string);

    width: 360px;
    height: body.preferred-height;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000080;
    drop-shadow-offset-y: 8px;

    body := VerticalLayout {
        padding: Theme.gap-md;
        spacing: Theme.gap-sm;

        HorizontalLayout {
            spacing: Theme.gap-sm;
            alignment: start;
            StatusDot { tint: Theme.warning; }
            Text {
                text: root.rows.length == 1
                    ? "1 pending approval"
                    : root.rows.length + " pending approvals";
                color: Theme.text-primary;
                font-size: Theme.font-body;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Flickable {
            height: min(440px, stack.preferred-height);
            viewport-height: stack.preferred-height;
            stack := VerticalLayout {
                spacing: Theme.gap-sm;
                for row in root.rows : ApprovalCard {
                    data: row;
                    focused: row.id == root.focused-id;
                    approve(id) => { root.approve(id); }
                    deny(id) => { root.deny(id); }
                    approve-always(id, server, tool) => {
                        root.approve-always(id, server, tool);
                    }
                }
            }
        }
    }
}
