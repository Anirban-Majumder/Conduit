// Bottom-right approvals popup: the non-blocking queue of pending tool-call
// requests. Renders only while approvals.length > 0 (guarded in main.slint) and
// auto-dismisses when the queue empties. Each compact card offers Approve /
// Deny / Approve-always inline; clicking the card body opens the full
// "Approval Required" detail modal (open-details).

import { Theme } from "../theme.slint";
import { PillButton, Icon, StatusDot } from "primitives.slint";
import { ApprovalRow } from "../structs.slint";

component ApprovalCard inherits Rectangle {
    in property <ApprovalRow> data;
    in property <bool> focused;
    callback approve(string);
    callback deny(string);
    callback approve-always(string, string, string);
    callback open-details(ApprovalRow);

    background: Theme.surface-2;
    border-radius: Theme.radius-input;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.accent : Theme.border;

    VerticalLayout {
        padding: Theme.gap-md;
        spacing: Theme.gap-sm;

        info-ta := TouchArea {
            height: title-col.preferred-height;
            clicked => { root.open-details(root.data); }
            HorizontalLayout {
                spacing: Theme.gap-sm;
                alignment: space-between;
                title-col := VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: root.data.server + " · " + root.data.tool;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: root.data.ide_name;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                        overflow: elide;
                    }
                }
                Icon {
                    source: @image-url("../../../assets/icons/circle-help.svg");
                    tint: info-ta.has-hover ? Theme.accent : Theme.text-tertiary;
                    size: 16px;
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap-sm;
            PillButton {
                label: "Approve";
                bg-color: Theme.accent;
                fg-color: Theme.on-accent;
                clicked => { root.approve(root.data.id); }
            }
            PillButton {
                label: "Deny";
                outline: true;
                bg-color: transparent;
                fg-color: Theme.text-primary;
                clicked => { root.deny(root.data.id); }
            }
        }
        always-ta := TouchArea {
            height: 18px;
            clicked => {
                root.approve-always(root.data.id, root.data.server, root.data.tool);
            }
            Text {
                text: "✓ Approve always for this tool";
                color: always-ta.has-hover ? Theme.accent-bright : Theme.accent;
                font-size: Theme.font-body-sm;
                horizontal-alignment: center;
            }
        }
    }
}

export component ApprovalsPopup inherits Rectangle {
    in property <[ApprovalRow]> rows;
    in property <string> focused-id;
    callback approve(string);
    callback deny(string);
    callback approve-always(string, string, string);
    callback open-details(ApprovalRow);

    width: 360px;
    height: body.preferred-height;
    background: Theme.surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 32px;
    drop-shadow-color: #000000a6;
    drop-shadow-offset-y: 10px;

    body := VerticalLayout {
        padding: Theme.gap-md;
        spacing: Theme.gap-sm;

        HorizontalLayout {
            spacing: Theme.gap-sm;
            alignment: start;
            Icon {
                source: @image-url("../../../assets/icons/shield-check.svg");
                tint: Theme.accent;
                size: 18px;
            }
            Text {
                text: root.rows.length == 1
                    ? "1 pending approval"
                    : root.rows.length + " pending approvals";
                color: Theme.text-primary;
                font-size: Theme.font-body;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Flickable {
            height: min(440px, stack.preferred-height);
            viewport-height: stack.preferred-height;
            stack := VerticalLayout {
                spacing: Theme.gap-sm;
                for row in root.rows : ApprovalCard {
                    data: row;
                    focused: row.id == root.focused-id;
                    approve(id) => { root.approve(id); }
                    deny(id) => { root.deny(id); }
                    approve-always(id, server, tool) => {
                        root.approve-always(id, server, tool);
                    }
                    open-details(r) => { root.open-details(r); }
                }
            }
        }
    }
}
