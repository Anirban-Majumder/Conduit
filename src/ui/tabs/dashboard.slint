// Dashboard tab: at-a-glance overview and the app's landing tab (tab 0).
// A server-health ring hero + four KPI cards, then Active Servers and a
// Recent Activity feed — all reusing the servers/skills/audit models the glue
// pushes, plus DashboardStats for headline counts. Cards/rows are clickable;
// navigation (open-tab / open-server / add-server) is delegated to main.slint.

import { Theme } from "../theme.slint";
import { StatusDot, Icon, Chip } from "../components/primitives.slint";
import { DashboardStats, ServerRow, SkillRow, AuditRow } from "../structs.slint";

component GlassPanel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 4px;
    // Top "rim of glass" highlight.
    Rectangle {
        y: 0;
        height: 1px;
        width: parent.width - 2 * Theme.radius-card;
        x: Theme.radius-card;
        background: Theme.glass-rim;
    }
}

component KpiCard inherits GlassPanel {
    in property <image> icon;
    in property <int> value;
    in property <string> label;
    in property <string> chip-label;
    in property <color> chip-fg: Theme.accent;
    in property <color> chip-bg: Theme.accent-tint;
    in property <color> tint: Theme.accent;
    callback clicked <=> ta.clicked;
    border-color: ta.has-hover ? Theme.border-strong : Theme.border;
    horizontal-stretch: 1;

    ta := TouchArea {
        VerticalLayout {
            padding: Theme.gap-lg;
            spacing: Theme.gap-sm;
            HorizontalLayout {
                alignment: space-between;
                Icon { source: root.icon; tint: root.tint; size: 22px; }
                if root.chip-label != "" : Chip {
                    label: root.chip-label;
                    fg: root.chip-fg;
                    bg: root.chip-bg;
                    dot: true;
                }
            }
            Text {
                text: root.value;
                color: Theme.text-primary;
                font-size: Theme.font-headline;
                font-weight: 700;
            }
            Text {
                text: root.label;
                color: Theme.text-tertiary;
                font-size: Theme.font-eyebrow;
                font-weight: 600;
            }
        }
    }
}

export component DashboardTab inherits Rectangle {
    in property <DashboardStats> stats;
    in property <[ServerRow]> servers;
    in property <[SkillRow]> skills;
    in property <[AuditRow]> audit;
    callback open-tab(int);
    callback open-server(string);
    callback add-server();

    property <int> health-pct: root.stats.server-count > 0
        ? root.stats.server-live * 100 / root.stats.server-count
        : 100;
    property <bool> all-healthy: root.stats.server-count == 0
        || (root.stats.server-auth-failures == 0 && root.stats.server-live == root.stats.server-count);
    property <color> health-tint: root.all-healthy ? Theme.accent : Theme.warning;

    VerticalLayout {
        spacing: Theme.gap-lg;

        // Hero + KPI grid.
        HorizontalLayout {
            spacing: Theme.gap-lg;
            height: 260px;

            // Health ring hero.
            GlassPanel {
                width: 38%;
                VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-sm;
                    alignment: center;

                    Rectangle {
                        height: 130px;
                        ring-glow := Rectangle {
                            width: 130px;
                            height: 130px;
                            x: (parent.width - self.width) / 2;
                            border-radius: Theme.radius-pill;
                            background: transparent;
                            drop-shadow-blur: 32px;
                            drop-shadow-color: Theme.accent-glow;
                        }
                        Rectangle {
                            width: 130px;
                            height: 130px;
                            x: (parent.width - self.width) / 2;
                            border-radius: Theme.radius-pill;
                            border-width: 4px;
                            border-color: root.health-tint;
                            VerticalLayout {
                                alignment: center;
                                spacing: 0px;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: root.health-pct;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-headline;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "%";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-body;
                                        vertical-alignment: bottom;
                                    }
                                }
                                Text {
                                    text: "HEALTHY";
                                    color: root.health-tint;
                                    font-size: Theme.font-eyebrow;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                    Text {
                        text: root.all-healthy ? "System Optimal" : "Needs attention";
                        color: Theme.text-primary;
                        font-size: Theme.font-headline-sm;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.stats.server-count == 0
                            ? "No servers configured yet. Add one from the Servers tab."
                            : root.all-healthy
                            ? "All MCP servers are reachable and routing traffic. No critical issues detected."
                            : (root.stats.server-count - root.stats.server-live) + " server(s) need attention — check the Servers tab.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-body-sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            // 2x2 KPI grid.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.gap-lg;
                HorizontalLayout {
                    spacing: Theme.gap-lg;
                    KpiCard {
                        icon: @image-url("../../../assets/icons/server.svg");
                        value: root.stats.server-count;
                        label: "TOTAL SERVERS";
                        chip-label: root.stats.server-live > 0 ? root.stats.server-live + " ACTIVE" : "";
                        clicked => { root.open-tab(1); }
                    }
                    KpiCard {
                        icon: @image-url("../../../assets/icons/puzzle.svg");
                        value: root.stats.skill-count;
                        label: "INSTALLED SKILLS";
                        chip-label: "";
                        clicked => { root.open-tab(3); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap-lg;
                    KpiCard {
                        icon: @image-url("../../../assets/icons/terminal.svg");
                        value: root.stats.editor-count;
                        label: "CONNECTED EDITORS";
                        chip-label: root.stats.editor-count > 0 ? "SYNCED" : "";
                        clicked => { root.open-tab(2); }
                    }
                    KpiCard {
                        icon: @image-url("../../../assets/icons/arrow-left-right.svg");
                        value: root.stats.calls-24h;
                        label: "CALLS (24H)";
                        chip-label: root.stats.denied-24h > 0 ? root.stats.denied-24h + " DENIED" : "";
                        chip-fg: Theme.danger;
                        chip-bg: Theme.danger-tint;
                        tint: root.stats.denied-24h > 0 ? Theme.warning : Theme.accent;
                        clicked => { root.open-tab(4); }
                    }
                }
            }
        }

        // Active Servers + Recent Activity.
        HorizontalLayout {
            spacing: Theme.gap-lg;
            vertical-stretch: 1;

            GlassPanel {
                width: 34%;
                VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Active Servers";
                            color: Theme.text-primary;
                            font-size: Theme.font-body-lg;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        add-ta := TouchArea {
                            width: 26px;
                            height: 26px;
                            clicked => { root.add-server(); }
                            Icon {
                                source: @image-url("../../../assets/icons/plus.svg");
                                tint: add-ta.has-hover ? Theme.accent : Theme.text-secondary;
                                size: 20px;
                            }
                        }
                    }
                    if root.servers.length == 0 : Text {
                        text: "No servers configured yet.";
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                    }
                    Flickable {
                        viewport-height: srv-stack.preferred-height;
                        srv-stack := VerticalLayout {
                            spacing: Theme.gap-sm;
                            for s in root.servers : Rectangle {
                                height: 52px;
                                background: srv-ta.has-hover ? Theme.surface-3 : Theme.surface-2;
                                border-radius: Theme.radius-input;
                                srv-ta := TouchArea {
                                    clicked => { root.open-server(s.name); }
                                    HorizontalLayout {
                                        padding-left: Theme.gap-md;
                                        padding-right: Theme.gap-md;
                                        spacing: Theme.gap-sm;
                                        alignment: space-between;
                                        HorizontalLayout {
                                            spacing: Theme.gap-sm;
                                            alignment: start;
                                            VerticalLayout {
                                                alignment: center;
                                                StatusDot {
                                                    tint: s.auth_failure ? Theme.warning : Theme.success;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 1px;
                                                Text {
                                                    text: s.name;
                                                    color: Theme.text-primary;
                                                    font-size: Theme.font-body;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: s.transport;
                                                    color: Theme.text-tertiary;
                                                    font-size: Theme.font-body-sm;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: s.auth_failure ? "needs auth" : s.tool_count_label;
                                                color: s.auth_failure ? Theme.warning : Theme.text-tertiary;
                                                font-size: Theme.font-body-sm;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            GlassPanel {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Recent Activity";
                            color: Theme.text-primary;
                            font-size: Theme.font-body-lg;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        viewlog-ta := TouchArea {
                            width: 70px;
                            clicked => { root.open-tab(4); }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: end;
                                VerticalLayout {
                                    alignment: center;
                                    StatusDot { tint: Theme.accent; }
                                }
                                Text {
                                    text: "Live";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body-sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    // Column header.
                    HorizontalLayout {
                        padding-left: Theme.gap-sm;
                        padding-right: Theme.gap-sm;
                        spacing: Theme.gap-md;
                        Text {
                            text: "TIME";
                            color: Theme.text-tertiary;
                            font-size: Theme.font-eyebrow;
                            font-weight: 600;
                            width: 84px;
                        }
                        Text {
                            text: "ROUTE";
                            color: Theme.text-tertiary;
                            font-size: Theme.font-eyebrow;
                            font-weight: 600;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "STATUS";
                            color: Theme.text-tertiary;
                            font-size: Theme.font-eyebrow;
                            font-weight: 600;
                            width: 92px;
                        }
                        Text {
                            text: "LATENCY";
                            color: Theme.text-tertiary;
                            font-size: Theme.font-eyebrow;
                            font-weight: 600;
                            width: 64px;
                            horizontal-alignment: right;
                        }
                    }
                    if root.audit.length == 0 : Text {
                        text: "No tool calls recorded yet.";
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                    }
                    Flickable {
                        viewport-height: act-stack.preferred-height;
                        act-stack := VerticalLayout {
                            spacing: 0px;
                            for a in root.audit : Rectangle {
                                height: 40px;
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: Theme.border;
                                }
                                HorizontalLayout {
                                    padding-left: Theme.gap-sm;
                                    padding-right: Theme.gap-sm;
                                    spacing: Theme.gap-md;
                                    Text {
                                        text: a.ts_label;
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-body-sm;
                                        font-family: "Space Mono";
                                        vertical-alignment: center;
                                        width: 84px;
                                    }
                                    Text {
                                        text: a.ide_name + " → " + a.server + "." + a.tool;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-body-sm;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        width: 92px;
                                        Chip {
                                            label: (a.decision == "allow" || a.decision == "ask_approved") ? "ALLOWED"
                                                 : (a.decision == "deny" || a.decision == "ask_denied") ? "DENIED"
                                                 : a.decision == "ask_timeout" ? "TIMEOUT"
                                                 : a.decision == "error" ? "ERROR"
                                                 : a.decision == "cancelled" ? "CANCELLED"
                                                 : a.decision;
                                            fg: (a.decision == "deny" || a.decision == "ask_denied" || a.decision == "error")
                                                ? Theme.danger
                                                : a.decision == "ask_timeout" ? Theme.warning
                                                : Theme.accent;
                                            bg: (a.decision == "deny" || a.decision == "ask_denied" || a.decision == "error")
                                                ? Theme.danger-tint
                                                : Theme.accent-tint;
                                        }
                                    }
                                    Text {
                                        text: a.latency_label;
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-body-sm;
                                        vertical-alignment: center;
                                        width: 64px;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
