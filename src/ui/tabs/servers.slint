// Servers tab: master/detail view of configured MCP servers.
// Defines HealthCard (probe status) and TargetToggle (the per-IDE on/off chip,
// also reused by the Skills tab), plus ServersTab which composes them with the
// shared ToolPolicyTable from approvals.slint.

import { Theme } from "../theme.slint";
import { PillButton, StatusDot } from "../components/primitives.slint";
import { ServerDetail, ServerIdeTarget, ServerRow, ToolPolicyRow } from "../structs.slint";
import { ToolPolicyTable } from "../tabs/approvals.slint";

export component HealthCard inherits Rectangle {
    in property <ServerDetail> detail;
    callback copy-error();
    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: Theme.gap-md;
        spacing: 4px;
        HorizontalLayout {
            spacing: Theme.gap-sm;
            alignment: start;
            StatusDot {
                tint: detail.health-state == "live" ? Theme.success
                     : detail.health-state == "idle" ? Theme.text-tertiary
                     : detail.health-state == "needsauth" ? Theme.warning
                     : detail.health-state == "paused" ? Theme.text-tertiary
                     : detail.health-state == "down" ? Theme.danger
                     : Theme.text-tertiary;
            }
            Text {
                text: detail.health-state == "live" ? "Live"
                     : detail.health-state == "idle" ? "Idle"
                     : detail.health-state == "needsauth" ? "Needs sign-in"
                     : detail.health-state == "paused" ? "Paused"
                     : detail.health-state == "down" ? "Down"
                     : detail.health-state == "unprobed" ? "Unprobed"
                     : detail.health-state;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
        }
        Text {
            text: "Last probe: " + detail.last-probe-label;
            color: Theme.text-tertiary;
            font-size: Theme.font-body-sm;
        }
        if detail.last-error != "" : VerticalLayout {
            spacing: 4px;
            Text {
                text: detail.last-error;
                color: Theme.danger;
                font-size: Theme.font-body-sm;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                PillButton {
                    label: "Copy error";
                    clicked => { root.copy-error(); }
                }
            }
        }
    }
}

// Shared on/off chip: bright (accent) when active, muted (surface-3) when not.
// Used both by the Servers tab (per-IDE enable/disable for an MCP server) and
// the Skills tab (per-IDE sync targets for an installed skill).

export component TargetToggle inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback toggle();
    background: root.active ? Theme.accent : Theme.surface-3;
    border-radius: Theme.radius-sm;
    height: 28px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.bg : Theme.text-secondary;
            font-size: Theme.font-body-sm;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.toggle(); } }
}


export component ServersTab inherits Rectangle {
    in property <[ServerRow]> rows;
    in property <string> selected;
    in property <ServerDetail> detail;
    in property <[ToolPolicyRow]> tools;
    in property <[ServerIdeTarget]> targets;
    callback select-server(string);
    callback delete-clicked(string);
    callback retest-clicked(string);
    callback edit-clicked(string);
    callback change-tool-policy(string, string, string);   // server, tool, decision
    callback toggle-target(string, string, bool);  // server, ide_kind, enable
    callback add-clicked();
    callback copy-error-clicked(string);

    HorizontalLayout {
        spacing: Theme.gap-md;

        Rectangle {
            width: 240px;
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.gap-sm;
                spacing: Theme.gap-sm;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Servers";
                        color: Theme.text-secondary;
                        font-size: Theme.font-eyebrow;
                        vertical-alignment: center;
                    }
                    PillButton {
                        label: "+ Add";
                        bg-color: Theme.accent;
                        fg-color: Theme.bg;
                        clicked => { root.add-clicked(); }
                    }
                }
                if rows.length == 0 : Text {
                    text: "No MCP servers yet. Click Add to begin.";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                    wrap: word-wrap;
                }
                for row in rows : Rectangle {
                    background: row.name == root.selected ? Theme.surface-2 : transparent;
                    border-radius: Theme.radius-sm;
                    min-height: 40px;
                    ta := TouchArea {
                        clicked => { root.select-server(row.name); }
                    }
                    HorizontalLayout {
                        padding-left: Theme.gap-sm;
                        padding-right: Theme.gap-sm;
                        spacing: Theme.gap-sm;
                        alignment: start;
                        StatusDot {
                            tint: row.status == "live" ? Theme.success
                                 : row.status == "down" ? Theme.danger
                                 : row.status == "needsauth" ? Theme.warning
                                 : Theme.text-tertiary;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: row.name;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body-sm;
                                    vertical-alignment: center;
                                }
                                if row.auth_failure : Rectangle {
                                    background: Theme.danger;
                                    border-radius: 999px;
                                    height: 16px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: "auth";
                                            color: Theme.bg;
                                            font-size: Theme.font-eyebrow;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: row.transport + " · " + row.tool_count_label;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-body-sm;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.gap-md;
                spacing: Theme.gap-md;
                if root.selected == "" : Text {
                    text: "Select a server on the left, or click Add.";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                }
                if root.selected != "" : VerticalLayout {
                    spacing: Theme.gap-md;
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: detail.name;
                                color: Theme.text-primary;
                                font-size: 18px;
                            }
                            Text {
                                text: detail.version != "" ? detail.version : "—";
                                color: Theme.text-secondary;
                                font-size: Theme.font-body-sm;
                            }
                            Text {
                                text: detail.transport + " · " + detail.command-or-url;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-body-sm;
                                wrap: word-wrap;
                            }
                            Text {
                                text: detail.lifecycle-label + " · " + detail.tool-count-label;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-body-sm;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.gap-sm;
                            alignment: center;
                            PillButton {
                                label: "Re-test";
                                clicked => { root.retest-clicked(root.selected); }
                            }
                            PillButton {
                                label: "Edit";
                                clicked => { root.edit-clicked(root.selected); }
                            }
                            PillButton {
                                label: "Delete";
                                bg-color: Theme.danger;
                                fg-color: Theme.bg;
                                clicked => { root.delete-clicked(root.selected); }
                            }
                        }
                    }
                    HealthCard {
                        detail: root.detail;
                        copy-error => { root.copy-error-clicked(root.detail.last-error); }
                    }
                    if root.detail.auth-failure-msg != "" : Rectangle {
                        background: #4d1f1f;
                        border-radius: Theme.radius-sm;
                        min-height: 56px;
                        HorizontalLayout {
                            padding: Theme.gap-sm;
                            spacing: Theme.gap-sm;
                            alignment: space-between;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Authentication failed";
                                    color: #ffaaaa;
                                    font-size: Theme.font-body;
                                }
                                Text {
                                    text: root.detail.auth-failure-msg;
                                    color: #ffaaaa;
                                    font-size: Theme.font-body-sm;
                                    wrap: word-wrap;
                                }
                            }
                            PillButton {
                                label: "Edit";
                                bg-color: Theme.accent;
                                fg-color: Theme.bg;
                                clicked => { root.edit-clicked(root.selected); }
                            }
                        }
                    }
                    // Per-IDE enable/disable. Same TargetToggle component as the
                    // Skills tab — bright when the server is in that IDE's MCP
                    // config, muted when it isn't.
                    if targets.length > 0 : Text {
                        text: "IDEs";
                        color: Theme.text-secondary;
                        font-size: Theme.font-eyebrow;
                    }
                    if targets.length > 0 : Flickable {
                        viewport-width: ide-row.preferred-width;
                        viewport-height: self.height;
                        height: 36px;
                        ide-row := HorizontalLayout {
                            spacing: 6px;
                            for t in targets : TargetToggle {
                                label: t.label;
                                active: t.active;
                                toggle => {
                                    root.toggle-target(root.selected, t.ide-kind, !t.active);
                                }
                            }
                        }
                    }
                    if tools.length > 0 : Text {
                        text: "Tools (" + tools.length + ")";
                        color: Theme.text-secondary;
                        font-size: Theme.font-eyebrow;
                    }
                    if tools.length > 0 : ToolPolicyTable {
                        rows: root.tools;
                        change-decision(tool, decision) => {
                            root.change-tool-policy(root.selected, tool, decision);
                        }
                    }
                    if tools.length == 0 : Text {
                        text: "No tools discovered. Click Re-test.";
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                    }
                }
            }
        }
    }
}

