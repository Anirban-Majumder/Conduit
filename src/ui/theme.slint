// Theme: the global design-token set (colors, type scale, radii, spacing).
// Imported by every other .slint file so they share one source of names.
//
// Verge editorial palette. Polished pass against DESIGN.md is a Stage 4.5 item;
// this is the load-bearing token set so all .slint files reach the same names.

export global Theme {
    // Surface
    out property <color> bg: #0a0a0a;
    out property <color> surface: #131313;
    out property <color> surface-2: #1a1a1a;
    out property <color> surface-3: #232323;

    // Text
    out property <color> text-primary: #f4f4f4;
    out property <color> text-secondary: #a8a8a8;
    out property <color> text-tertiary: #6a6a6a;

    // Accent (mint per spec — tray glyph etc.)
    out property <color> accent: #7fffd4;
    out property <color> accent-dim: #4a8b78;

    // States
    out property <color> warning: #ffb86b;
    out property <color> danger: #ff6b6b;
    out property <color> success: #7fffd4;

    // Borders
    out property <color> border: #2a2a2a;
    out property <color> border-strong: #3a3a3a;

    // Type scale (px)
    out property <length> font-eyebrow: 11px;
    out property <length> font-body-sm: 12px;
    out property <length> font-body: 14px;
    out property <length> font-body-lg: 16px;
    out property <length> font-h3: 20px;
    out property <length> font-h2: 28px;
    out property <length> font-h1: 40px;

    // Radii
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;

    // Spacing
    out property <length> gap-xs: 4px;
    out property <length> gap-sm: 8px;
    out property <length> gap-md: 16px;
    out property <length> gap-lg: 24px;
    out property <length> gap-xl: 40px;
}
