import { Theme } from "theme.slint";

// Data structs exposed to Rust via Slint's struct-binding. Numeric fields are
// stringified on the Rust side so Slint Text bindings stay trivial.

export struct ApprovalRow {
    id: string,
    ide_name: string,
    server: string,
    tool: string,
    created_at: string,
}

export struct ServerRow {
    name: string,
    transport: string,
    lifecycle_label: string,    // "persistent" / "ephemeral" / "300s idle"
    status: string,             // "running" | "idle" | "crashed"
    tool_count_label: string,
}

export struct IdeRow {
    name: string,
    key: string,
    config_path: string,
}

export struct PolicyRow {
    server: string,
    tool: string,
    decision: string,           // "allow" | "deny" | "ask"
    source: string,
}

export struct ToolPolicyRow {
    name: string,
    description: string,
    decision: string,           // "allow" | "ask" | "deny"
}

export struct ServerDetail {
    name: string,
    version: string,                // "server_version" from probe
    transport: string,              // "stdio" | "http"
    command_or_url: string,
    lifecycle_label: string,
    health_state: string,           // "live" | "idle" | "down" | "unprobed" | "needsauth" | "paused"
    last_probe_label: string,       // "2m ago" or "never"
    last_error: string,             // empty if no error
    tool_count_label: string,       // "12 tools"
}


export struct AuditRow {
    ts_label: string,
    ide_name: string,
    server: string,
    tool: string,
    decision: string,
    latency_label: string,
}

export struct SettingsRow {
    port: string,
    approval_timeout: string,
    default_lifecycle: string,
    audit_retention: string,
    theme: string,
    autostart_at_login: string,
    notifications_enabled: string,
}

export struct SkillRow {
    key: string,
    directory: string,
    name: string,
    description: string,
    repo_label: string,
    repo_owner: string,
    repo_name: string,
    repo_branch: string,
    source_directory: string,
    readme_url: string,
    installed: bool,
    target_claude: bool,
    target_openclaude: bool,
    target_opencode: bool,
}

export struct SkillRepoRow {
    owner: string,
    name: string,
    branch: string,
    enabled: bool,
}

// ----- Reusable components (defined before use) -----

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <int> badge;
    callback clicked <=> ta.clicked;

    background: active ? Theme.surface-2 : transparent;
    border-radius: Theme.radius-sm;
    height: 36px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.label;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }

        if root.badge > 0 : Rectangle {
            background: Theme.accent;
            border-radius: 999px;
            min-width: 18px;
            height: 18px;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                Text {
                    text: root.badge;
                    color: Theme.bg;
                    font-size: Theme.font-eyebrow;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }

    ta := TouchArea {}
}

component StatusDot inherits Rectangle {
    in property <color> tint;
    background: root.tint;
    border-radius: 999px;
    width: 8px;
    height: 8px;
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <color> bg-color: Theme.surface-3;
    in property <color> fg-color: Theme.text-primary;
    callback clicked <=> ta.clicked;
    background: root.bg-color;
    border-radius: Theme.radius-sm;
    height: 28px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            color: root.fg-color;
            font-size: Theme.font-body-sm;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {}
}

component RowCard inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    height: 64px;
}

component EmptyState inherits Rectangle {
    in property <string> text;
    background: transparent;
    VerticalLayout {
        alignment: center;
        Text {
            text: root.text;
            color: Theme.text-tertiary;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
    }
}

component SettingLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 28px;
    HorizontalLayout {
        spacing: Theme.gap-md;
        alignment: space-between;
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-body-sm;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: Theme.text-primary;
            font-size: Theme.font-body-sm;
            vertical-alignment: center;
        }
    }
}

// ----- Tab components -----

component ApprovalsTab inherits Rectangle {
    in property <[ApprovalRow]> rows;
    in property <string> focused-id;
    callback approve-clicked(string);
    callback deny-clicked(string);

    VerticalLayout {
        spacing: Theme.gap-sm;
        Text {
            text: rows.length > 0 ? "Pending approvals (" + rows.length + ")" : "No pending approvals";
            color: Theme.text-secondary;
            font-size: Theme.font-eyebrow;
        }
        if rows.length == 0 : EmptyState {
            text: "When an IDE calls a tool whose policy is `ask`, the request appears here.";
            height: 200px;
        }
        for row in rows : Rectangle {
            background: row.id == root.focused-id ? Theme.surface-2 : Theme.surface;
            border-radius: Theme.radius-md;
            border-width: row.id == root.focused-id ? 2px : 1px;
            border-color: row.id == root.focused-id ? Theme.accent : Theme.border;
            min-height: 56px;
            HorizontalLayout {
                padding-left: Theme.gap-md;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-md;
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: row.server + "." + row.tool;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                    }
                    Text {
                        text: row.ide_name + " · " + row.id;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    alignment: center;
                    PillButton {
                        label: "Approve";
                        bg-color: Theme.accent;
                        fg-color: Theme.bg;
                        clicked => { root.approve-clicked(row.id); }
                    }
                    PillButton {
                        label: "Deny";
                        clicked => { root.deny-clicked(row.id); }
                    }
                }
            }
        }
    }
}

component ToolPolicyRowItem inherits Rectangle {
    in property <string> name;
    in property <string> description;
    in property <string> decision;
    property <bool> expanded: false;
    callback change-decision(string);
    background: Theme.surface;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: Theme.gap-sm;
        spacing: 4px;
        HorizontalLayout {
            spacing: Theme.gap-md;
            alignment: space-between;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                ta := TouchArea {
                    clicked => { root.expanded = !root.expanded; }
                    Text {
                        text: root.name;
                        color: Theme.text-primary;
                        font-size: Theme.font-body-sm;
                    }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: center;
                PillButton {
                    label: "Allow";
                    bg-color: root.decision == "allow" ? Theme.accent : Theme.surface-3;
                    fg-color: root.decision == "allow" ? Theme.bg : Theme.text-secondary;
                    clicked => { root.change-decision("allow"); }
                }
                PillButton {
                    label: "Ask";
                    bg-color: root.decision == "ask" ? Theme.warning : Theme.surface-3;
                    fg-color: root.decision == "ask" ? Theme.bg : Theme.text-secondary;
                    clicked => { root.change-decision("ask"); }
                }
                PillButton {
                    label: "Deny";
                    bg-color: root.decision == "deny" ? Theme.danger : Theme.surface-3;
                    fg-color: root.decision == "deny" ? Theme.text-primary : Theme.text-secondary;
                    clicked => { root.change-decision("deny"); }
                }
            }
        }
        if root.description != "" : Text {
            text: root.description;
            color: Theme.text-tertiary;
            font-size: Theme.font-body-sm;
            wrap: word-wrap;
            overflow: elide;
            height: root.expanded ? self.preferred-height : 32px;
        }
        if root.description != "" : Rectangle {
            height: 16px;
            background: transparent;
            TouchArea {
                clicked => { root.expanded = !root.expanded; }
                Text {
                    text: root.expanded ? "Show less ▴" : "Show more ▾";
                    color: Theme.accent;
                    font-size: Theme.font-body-sm;
                }
            }
        }
    }
}

component ToolPolicyTable inherits Rectangle {
    in property <[ToolPolicyRow]> rows;
    in property <length> list-max-height: 320px;
    callback change-decision(string, string);
    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: Theme.gap-sm;
            alignment: end;
            Text {
                text: "Set all:";
                color: Theme.text-tertiary;
                font-size: Theme.font-body-sm;
                vertical-alignment: center;
            }
            PillButton {
                label: "🟢";
                clicked => { root.change-decision("*", "allow"); }
            }
            PillButton {
                label: "🟡";
                clicked => { root.change-decision("*", "ask"); }
            }
            PillButton {
                label: "🔴";
                clicked => { root.change-decision("*", "deny"); }
            }
        }
        Flickable {
            height: root.list-max-height;
            viewport-height: content-layout.preferred-height;
            content-layout := VerticalLayout {
                spacing: 6px;
                for tool in rows : ToolPolicyRowItem {
                    name: tool.name;
                    description: tool.description;
                    decision: tool.decision;
                    change-decision(d) => { root.change-decision(tool.name, d); }
                }
            }
        }
    }
}

component HealthCard inherits Rectangle {
    in property <ServerDetail> detail;
    callback copy-error();
    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: Theme.gap-md;
        spacing: 4px;
        HorizontalLayout {
            spacing: Theme.gap-sm;
            alignment: start;
            StatusDot {
                tint: detail.health-state == "live" ? Theme.success
                     : detail.health-state == "idle" ? Theme.text-tertiary
                     : detail.health-state == "needsauth" ? Theme.warning
                     : detail.health-state == "paused" ? Theme.text-tertiary
                     : detail.health-state == "down" ? Theme.danger
                     : Theme.text-tertiary;
            }
            Text {
                text: detail.health-state == "live" ? "Live"
                     : detail.health-state == "idle" ? "Idle"
                     : detail.health-state == "needsauth" ? "Needs sign-in"
                     : detail.health-state == "paused" ? "Paused"
                     : detail.health-state == "down" ? "Down"
                     : detail.health-state == "unprobed" ? "Unprobed"
                     : detail.health-state;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
        }
        Text {
            text: "Last probe: " + detail.last-probe-label;
            color: Theme.text-tertiary;
            font-size: Theme.font-body-sm;
        }
        if detail.last-error != "" : VerticalLayout {
            spacing: 4px;
            Text {
                text: detail.last-error;
                color: Theme.danger;
                font-size: Theme.font-body-sm;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                PillButton {
                    label: "Copy error";
                    clicked => { root.copy-error(); }
                }
            }
        }
    }
}

component ServersTab inherits Rectangle {
    in property <[ServerRow]> rows;
    in property <string> selected;
    in property <ServerDetail> detail;
    in property <[ToolPolicyRow]> tools;
    callback select-server(string);
    callback delete-clicked(string);
    callback retest-clicked(string);
    callback change-tool-policy(string, string, string);   // server, tool, decision
    callback add-clicked();
    callback copy-error-clicked(string);

    HorizontalLayout {
        spacing: Theme.gap-md;

        // Master: server list
        Rectangle {
            width: 240px;
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.gap-sm;
                spacing: Theme.gap-sm;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Servers";
                        color: Theme.text-secondary;
                        font-size: Theme.font-eyebrow;
                        vertical-alignment: center;
                    }
                    PillButton {
                        label: "+ Add";
                        bg-color: Theme.accent;
                        fg-color: Theme.bg;
                        clicked => { root.add-clicked(); }
                    }
                }
                if rows.length == 0 : Text {
                    text: "No MCP servers yet. Click Add to begin.";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                    wrap: word-wrap;
                }
                for row in rows : Rectangle {
                    background: row.name == root.selected ? Theme.surface-2 : transparent;
                    border-radius: Theme.radius-sm;
                    min-height: 40px;
                    ta := TouchArea {
                        clicked => { root.select-server(row.name); }
                    }
                    HorizontalLayout {
                        padding-left: Theme.gap-sm;
                        padding-right: Theme.gap-sm;
                        spacing: Theme.gap-sm;
                        alignment: start;
                        StatusDot {
                            tint: row.status == "live" ? Theme.success
                                 : row.status == "down" ? Theme.danger
                                 : row.status == "needsauth" ? Theme.warning
                                 : Theme.text-tertiary;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: row.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-body-sm;
                            }
                            Text {
                                text: row.transport + " · " + row.tool_count_label;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-body-sm;
                            }
                        }
                    }
                }
            }
        }

        // Detail panel
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.gap-md;
                spacing: Theme.gap-md;
                if root.selected == "" : Text {
                    text: "Select a server on the left, or click Add.";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                }
                if root.selected != "" : VerticalLayout {
                    spacing: Theme.gap-md;
                    // Header
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: detail.name;
                                color: Theme.text-primary;
                                font-size: 18px;
                            }
                            Text {
                                text: detail.version != "" ? detail.version : "—";
                                color: Theme.text-secondary;
                                font-size: Theme.font-body-sm;
                            }
                            Text {
                                text: detail.transport + " · " + detail.command-or-url;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-body-sm;
                                wrap: word-wrap;
                            }
                            Text {
                                text: detail.lifecycle-label + " · " + detail.tool-count-label;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-body-sm;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.gap-sm;
                            alignment: center;
                            PillButton {
                                label: "Re-test";
                                clicked => { root.retest-clicked(root.selected); }
                            }
                            PillButton {
                                label: "Delete";
                                bg-color: Theme.danger;
                                fg-color: Theme.bg;
                                clicked => { root.delete-clicked(root.selected); }
                            }
                        }
                    }
                    HealthCard {
                        detail: root.detail;
                        copy-error => { root.copy-error-clicked(root.detail.last-error); }
                    }
                    // Tools + per-tool policy
                    if tools.length > 0 : Text {
                        text: "Tools (" + tools.length + ")";
                        color: Theme.text-secondary;
                        font-size: Theme.font-eyebrow;
                    }
                    if tools.length > 0 : ToolPolicyTable {
                        rows: root.tools;
                        change-decision(tool, decision) => {
                            root.change-tool-policy(root.selected, tool, decision);
                        }
                    }
                    if tools.length == 0 : Text {
                        text: "No tools discovered. Click Re-test.";
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                    }
                }
            }
        }
    }
}

component TargetToggle inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback toggle();
    background: root.active ? Theme.accent : Theme.surface-3;
    border-radius: Theme.radius-sm;
    height: 28px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.bg : Theme.text-secondary;
            font-size: Theme.font-body-sm;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.toggle(); } }
}

component SkillsTab inherits Rectangle {
    in property <[SkillRow]> rows;
    in property <[SkillRepoRow]> repos;
    in property <string> status-message;
    in property <bool> busy;
    in-out property <string> repo-add-owner;
    in-out property <string> repo-add-name;
    in-out property <string> repo-add-branch: "main";
    callback refresh-clicked();
    callback open-folder-clicked();
    callback install-clicked(string, string, string, string, string, string);
    callback uninstall-clicked(string);
    callback toggle-target(string, string, bool);
    callback add-repo-clicked(string, string, string);
    callback remove-repo-clicked(string, string);
    callback toggle-repo-clicked(string, string, bool);

    Flickable {
        viewport-width: self.width;
        viewport-height: outer-vbox.preferred-height;
        outer-vbox := VerticalLayout {
            spacing: Theme.gap-md;

            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Agent skills";
                        color: Theme.text-primary;
                        font-size: Theme.font-body-lg;
                        font-weight: 700;
                    }
                    Text {
                        text: root.status-message != "" ? root.status-message
                            : (rows.length > 0
                                ? rows.length + " skills · " + repos.length + " sources"
                                : repos.length + " sources configured");
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    alignment: end;
                    PillButton {
                        label: "Open folder";
                        bg-color: Theme.surface-3;
                        fg-color: Theme.text-primary;
                        clicked => { root.open-folder-clicked(); }
                    }
                    PillButton {
                        label: root.busy ? "Refreshing…" : "Refresh";
                        bg-color: Theme.surface-3;
                        fg-color: Theme.text-primary;
                        clicked => {
                            if (!root.busy) { root.refresh-clicked(); }
                        }
                    }
                }
            }

            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: Theme.gap-md;
                    spacing: Theme.gap-sm;
                    Text {
                        text: "Discovery sources";
                        color: Theme.text-secondary;
                        font-size: Theme.font-eyebrow;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Rectangle {
                            background: Theme.bg;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: 32px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                owner-input := TextInput {
                                    text <=> root.repo-add-owner;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body-sm;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }
                        Rectangle {
                            background: Theme.bg;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: 32px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                name-input := TextInput {
                                    text <=> root.repo-add-name;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body-sm;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }
                        Rectangle {
                            background: Theme.bg;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: 32px;
                            width: 90px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                branch-input := TextInput {
                                    text <=> root.repo-add-branch;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body-sm;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }
                        PillButton {
                            label: "+ Add";
                            bg-color: Theme.accent;
                            fg-color: Theme.bg;
                            clicked => {
                                if (root.repo-add-owner != "" && root.repo-add-name != "") {
                                    root.add-repo-clicked(
                                        root.repo-add-owner,
                                        root.repo-add-name,
                                        root.repo-add-branch == "" ? "main" : root.repo-add-branch,
                                    );
                                    root.repo-add-owner = "";
                                    root.repo-add-name = "";
                                    root.repo-add-branch = "main";
                                }
                            }
                        }
                    }
                    Text {
                        text: "owner / repo / branch — e.g. anthropics / skills / main";
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                    }
                    for repo in repos : Rectangle {
                        background: Theme.bg;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 36px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: Theme.gap-sm;
                            Text {
                                text: repo.owner + "/" + repo.name + " @ " + repo.branch;
                                color: Theme.text-primary;
                                font-size: Theme.font-body-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: end;
                                TargetToggle {
                                    label: repo.enabled ? "Enabled" : "Disabled";
                                    active: repo.enabled;
                                    toggle => {
                                        root.toggle-repo-clicked(repo.owner, repo.name, !repo.enabled);
                                    }
                                }
                                PillButton {
                                    label: "Remove";
                                    clicked => {
                                        root.remove-repo-clicked(repo.owner, repo.name);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Text {
                text: rows.length == 0 ? "No skills" : "Skills (" + rows.length + ")";
                color: Theme.text-secondary;
                font-size: Theme.font-eyebrow;
            }
            if rows.length == 0 : EmptyState {
                text: "Add a discovery source above (e.g. anthropics/skills) and hit Refresh, or drop a skill folder into Open folder.";
                height: 160px;
            }
            for row in rows : Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: row.installed ? Theme.accent : Theme.border;
                min-height: 84px;
                HorizontalLayout {
                    padding: Theme.gap-md;
                    spacing: Theme.gap-md;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: Theme.gap-sm;
                            alignment: start;
                            Text {
                                text: row.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                            }
                            if row.installed : Rectangle {
                                background: Theme.accent;
                                border-radius: 999px;
                                height: 18px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Installed";
                                        color: Theme.bg;
                                        font-size: Theme.font-eyebrow;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Text {
                            text: row.description;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-body-sm;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                        Text {
                            text: row.repo_label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-eyebrow;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        if row.installed : HorizontalLayout {
                            spacing: 4px;
                            alignment: end;
                            TargetToggle {
                                label: "Claude";
                                active: row.target_claude;
                                toggle => {
                                    root.toggle-target(row.directory, "ClaudeCode", !row.target_claude);
                                }
                            }
                            TargetToggle {
                                label: "OpenClaude";
                                active: row.target_openclaude;
                                toggle => {
                                    root.toggle-target(row.directory, "OpenClaude", !row.target_openclaude);
                                }
                            }
                            TargetToggle {
                                label: "OpenCode";
                                active: row.target_opencode;
                                toggle => {
                                    root.toggle-target(row.directory, "OpenCode", !row.target_opencode);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.gap-sm;
                            alignment: end;
                            if row.installed : PillButton {
                                label: "Uninstall";
                                clicked => { root.uninstall-clicked(row.directory); }
                            }
                            if !row.installed : PillButton {
                                label: "Install";
                                bg-color: Theme.accent;
                                fg-color: Theme.bg;
                                clicked => {
                                    root.install-clicked(
                                        row.repo_owner,
                                        row.repo_name,
                                        row.repo_branch,
                                        row.source_directory,
                                        row.readme_url,
                                        row.name,
                                    );
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component EditorsTab inherits Rectangle {
    in property <[IdeRow]> rows;
    callback remove-clicked(string);
    callback add-clicked();
    VerticalLayout {
        spacing: Theme.gap-sm;
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: rows.length > 0 ? "Connected IDEs (" + rows.length + ")" : "No IDEs connected";
                color: Theme.text-secondary;
                font-size: Theme.font-eyebrow;
                vertical-alignment: center;
            }
            PillButton {
                label: "+ Add IDE";
                bg-color: Theme.accent;
                fg-color: Theme.bg;
                clicked => { root.add-clicked(); }
            }
        }
        if rows.length == 0 : EmptyState {
            text: "Connect an IDE via the (TBD) Add IDE flow.";
            height: 200px;
        }
        for row in rows : RowCard {
            HorizontalLayout {
                padding-left: Theme.gap-md;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-md;
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: row.name;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                    }
                    Text {
                        text: "key " + row.key + " · " + row.config_path;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body-sm;
                    }
                }
                PillButton {
                    label: "Remove";
                    clicked => { root.remove-clicked(row.name); }
                }
            }
        }
    }
}


component LogTab inherits Rectangle {
    in property <[AuditRow]> rows;
    VerticalLayout {
        spacing: Theme.gap-sm;
        Text {
            text: rows.length > 0 ? "Recent audit (" + rows.length + ")" : "Audit log empty";
            color: Theme.text-secondary;
            font-size: Theme.font-eyebrow;
        }
        if rows.length == 0 : EmptyState {
            text: "Every tool call is logged here with the policy decision + latency.";
            height: 200px;
        }
        for row in rows : Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;
            height: 48px;
            HorizontalLayout {
                padding-left: Theme.gap-md;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-md;
                alignment: space-between;
                HorizontalLayout {
                    spacing: Theme.gap-md;
                    alignment: center;
                    StatusDot {
                        tint: row.decision == "allow" || row.decision == "ask-approved" ? Theme.success
                             : row.decision == "deny" || row.decision == "ask-denied" ? Theme.danger
                             : Theme.warning;
                    }
                    Text {
                        text: row.ide_name + " → " + row.server + "." + row.tool;
                        color: Theme.text-primary;
                        font-size: Theme.font-body-sm;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: row.decision + " · " + row.latency_label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component SettingsTab inherits Rectangle {
    in property <SettingsRow> data;
    in property <bool> open-window-at-startup;
    in property <string> default-unknown-tool-policy;
    callback toggle-open-window(bool);
    callback set-default-policy(string);

    VerticalLayout {
        spacing: Theme.gap-md;

        // Startup
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.gap-md;
                spacing: Theme.gap-sm;
                Text {
                    text: "Startup";
                    color: Theme.text-secondary;
                    font-size: Theme.font-eyebrow;
                }
                Rectangle {
                    background: transparent;
                    min-height: 32px;
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        alignment: start;
                        Rectangle {
                            background: root.open-window-at-startup ? Theme.accent : Theme.surface-3;
                            border-radius: 4px;
                            width: 18px;
                            height: 18px;
                            Text {
                                text: root.open-window-at-startup ? "✓" : "";
                                color: Theme.bg;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ta := TouchArea {
                                clicked => {
                                    root.toggle-open-window(!root.open-window-at-startup);
                                }
                            }
                        }
                        Text {
                            text: "Open window when daemon starts";
                            color: Theme.text-primary;
                            font-size: Theme.font-body-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Approvals defaults
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.gap-md;
                spacing: Theme.gap-sm;
                Text {
                    text: "When an unknown tool is called";
                    color: Theme.text-secondary;
                    font-size: Theme.font-eyebrow;
                }
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    PillButton {
                        label: "Allow";
                        bg-color: root.default-unknown-tool-policy == "allow" ? Theme.accent : Theme.surface-3;
                        fg-color: root.default-unknown-tool-policy == "allow" ? Theme.bg : Theme.text-secondary;
                        clicked => { root.set-default-policy("allow"); }
                    }
                    PillButton {
                        label: "Ask";
                        bg-color: root.default-unknown-tool-policy == "ask" ? Theme.warning : Theme.surface-3;
                        fg-color: root.default-unknown-tool-policy == "ask" ? Theme.bg : Theme.text-secondary;
                        clicked => { root.set-default-policy("ask"); }
                    }
                    PillButton {
                        label: "Deny";
                        bg-color: root.default-unknown-tool-policy == "deny" ? Theme.danger : Theme.surface-3;
                        fg-color: root.default-unknown-tool-policy == "deny" ? Theme.text-primary : Theme.text-secondary;
                        clicked => { root.set-default-policy("deny"); }
                    }
                }
            }
        }

        // Read-only config.toml view
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.gap-md;
                spacing: 4px;
                Text {
                    text: "From config.toml (read-only)";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-eyebrow;
                }
                SettingLine { label: "daemon.port"; value: root.data.port; }
                SettingLine { label: "daemon.approval_timeout_seconds"; value: root.data.approval_timeout; }
                SettingLine { label: "daemon.default_lifecycle_seconds"; value: root.data.default_lifecycle; }
                SettingLine { label: "daemon.audit_retention_days"; value: root.data.audit_retention; }
                SettingLine { label: "daemon.autostart_at_login"; value: root.data.autostart_at_login; }
                SettingLine { label: "gui.theme"; value: root.data.theme; }
                SettingLine { label: "notifications.enabled"; value: root.data.notifications_enabled; }
            }
        }
    }
}

component HelpTab inherits Rectangle {
    VerticalLayout {
        spacing: Theme.gap-md;
        alignment: start;
        Text {
            text: "mcp-router v0";
            color: Theme.text-primary;
            font-size: Theme.font-h3;
        }
        Text {
            text: "Polished MCP proxy + policy enforcer. Routes IDE → MCP server traffic with per-tool approval gates, logs every tool call.";
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        Text {
            text: "URL pattern · http://127.0.0.1:<port>/<ide-key>/<server>/mcp";
            color: Theme.text-tertiary;
            font-size: Theme.font-body-sm;
        }
        Text {
            text: "Daemon logs · <state_root>/logs/daemon.log";
            color: Theme.text-tertiary;
            font-size: Theme.font-body-sm;
        }
    }
}

// ----- Modal dialogs -----

component LabeledInput inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text <=> input.text;
    spacing: 4px;
    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-eyebrow;
    }
    input := TextInput {
        color: Theme.text-primary;
        font-size: Theme.font-body;
        single-line: true;
        height: 32px;
    }
    Rectangle { background: Theme.border; height: 1px; }
}

component LabeledTextArea inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text <=> input.text;
    callback edited <=> input.edited;
    spacing: 4px;
    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-eyebrow;
    }
    Rectangle {
        background: Theme.surface-2;
        border-radius: Theme.radius-sm;
        height: 120px;
        input := TextInput {
            color: Theme.text-primary;
            font-size: Theme.font-body-sm;
            single-line: false;
            wrap: word-wrap;
            width: parent.width - 24px;
            height: parent.height - 16px;
            x: 12px;
            y: 8px;
        }
    }
}

component ModalShell inherits Rectangle {
    in property <string> title;
    callback dismiss();
    background: #000000aa;
    TouchArea { clicked => { root.dismiss(); } }
    Rectangle {
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        width: 560px;
        height: 560px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        // Trap clicks inside the card so dismiss() isn't fired by clicks on
        // the form itself — only the dim backdrop dismisses.
        TouchArea {}
        VerticalLayout {
            padding: Theme.gap-lg;
            spacing: Theme.gap-md;
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: Theme.font-h3;
                }
                PillButton {
                    label: "Close";
                    clicked => { root.dismiss(); }
                }
            }
            @children
        }
    }
}

component WizardStepIndicator inherits Rectangle {
    in property <int> step;        // current 1..3
    HorizontalLayout {
        spacing: Theme.gap-sm;
        alignment: start;
        for label[i] in ["Connection", "Probing", "Permissions"] : HorizontalLayout {
            spacing: 6px;
            Rectangle {
                background: root.step > i ? Theme.accent
                           : root.step == i + 1 ? Theme.warning
                           : Theme.surface-3;
                border-radius: 10px;
                width: 18px;
                height: 18px;
                Text {
                    text: i + 1;
                    color: root.step >= i + 1 ? Theme.bg : Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: label;
                color: root.step == i + 1 ? Theme.text-primary : Theme.text-tertiary;
                font-size: Theme.font-body-sm;
                vertical-alignment: center;
            }
        }
    }
}

component AddServerDialog inherits Rectangle {
    in-out property <string> name <=> name-input.text;
    in-out property <string> command <=> cmd-input.text;
    in-out property <string> args <=> args-input.text;
    in-out property <string> url <=> url-input.text;
    in-out property <string> headers <=> headers-input.text;
    in-out property <string> transport;
    in-out property <string> paste <=> paste-input.text;
    in-out property <string> status;
    in-out property <bool> status-is-error: false;
    in-out property <bool> busy: false;
    in property <int> step;
    in property <string> phase-status;
    in property <string> oauth-url;
    in property <[ToolPolicyRow]> tools;
    callback start-probe();
    callback wizard-save();
    callback wizard-back();
    callback change-tool-policy(string, string);
    callback dismiss();
    callback parse();
    callback copy-oauth-url();

    ModalShell {
        title: "Add MCP Server";
        dismiss => { root.dismiss(); }

        VerticalLayout {
            spacing: Theme.gap-md;

            WizardStepIndicator { step: root.step; }

            VerticalLayout {
                visible: root.step == 1;
                spacing: 6px;
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    PillButton {
                        label: "http";
                        bg-color: root.transport == "http" ? Theme.accent : Theme.surface-3;
                        fg-color: root.transport == "http" ? Theme.bg : Theme.text-secondary;
                        clicked => { root.transport = "http"; }
                    }
                    PillButton {
                        label: "stdio";
                        bg-color: root.transport == "stdio" ? Theme.accent : Theme.surface-3;
                        fg-color: root.transport == "stdio" ? Theme.bg : Theme.text-secondary;
                        clicked => { root.transport = "stdio"; }
                    }
                }
                name-input := LabeledInput { label: "Name (letters, digits, _, -, 1–64 chars)"; }
                cmd-input := LabeledInput {
                    label: "Command";
                    visible: root.transport == "stdio";
                }
                args-input := LabeledInput {
                    label: "Args, space-separated";
                    visible: root.transport == "stdio";
                }
                url-input := LabeledInput {
                    label: "URL";
                    visible: root.transport == "http";
                }
                headers-input := LabeledInput {
                    label: "Headers (KEY=value, comma separated)";
                    visible: root.transport == "http";
                }
                paste-input := LabeledTextArea {
                    label: "Paste full MCP JSON to auto-fill — parses as you type";
                    edited => { paste-debounce.running = false; paste-debounce.running = true; }
                }
                paste-debounce := Timer {
                    interval: 600ms;
                    running: false;
                    triggered => {
                        self.running = false;
                        if (root.paste != "") { root.parse(); }
                    }
                }

                if root.status != "" : Rectangle {
                    background: root.status-is-error ? #4d1f1f : Theme.surface-2;
                    border-radius: Theme.radius-sm;
                    min-height: 32px;
                    HorizontalLayout {
                        padding: Theme.gap-sm;
                        Text {
                            text: root.status;
                            color: root.status-is-error ? #ffaaaa : Theme.text-secondary;
                            font-size: Theme.font-body-sm;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    PillButton {
                        label: "Test connection";
                        bg-color: Theme.accent;
                        fg-color: Theme.bg;
                        clicked => { root.start-probe(); }
                    }
                }
            }

            // Step 2 — probing (plus OAuth sign-in state).
            if root.step == 2 : VerticalLayout {
                spacing: Theme.gap-md;
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    alignment: start;
                    Text { text: "⟳"; font-size: 24px; color: Theme.accent; vertical-alignment: center; }
                    Text {
                        text: root.phase-status != "" ? root.phase-status : "Probing upstream...";
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                }
                if root.oauth-url == "" : Text {
                    text: "Spawning, calling initialize, fetching tools — up to ~30 seconds per phase.";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body-sm;
                    wrap: word-wrap;
                }
                if root.oauth-url != "" : VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Browser tab opened for sign-in. If it didn't open, copy this URL:";
                        color: Theme.text-secondary;
                        font-size: Theme.font-body-sm;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        background: Theme.surface-2;
                        border-radius: Theme.radius-sm;
                        min-height: 36px;
                        HorizontalLayout {
                            padding: Theme.gap-sm;
                            spacing: Theme.gap-sm;
                            Text {
                                text: root.oauth-url;
                                color: Theme.text-primary;
                                font-size: Theme.font-body-sm;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            PillButton {
                                label: "Copy";
                                clicked => { root.copy-oauth-url(); }
                            }
                        }
                    }
                }
                if root.status != "" : Rectangle {
                    background: root.status-is-error ? #4d1f1f : Theme.surface-2;
                    border-radius: Theme.radius-sm;
                    min-height: 32px;
                    HorizontalLayout {
                        padding: Theme.gap-sm;
                        Text {
                            text: root.status;
                            color: root.status-is-error ? #ffaaaa : Theme.text-secondary;
                            font-size: Theme.font-body-sm;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    PillButton {
                        label: "← Back to edit";
                        clicked => { root.wizard-back(); }
                    }
                }
            }

            // Step 3 — per-tool policy
            if root.step == 3 : VerticalLayout {
                spacing: Theme.gap-md;
                Text {
                    text: root.tools.length + " tools discovered. Default: Ask. Set Allow to auto-approve.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body-sm;
                    wrap: word-wrap;
                }
                ToolPolicyTable {
                    rows: root.tools;
                    change-decision(tool, decision) => { root.change-tool-policy(tool, decision); }
                }
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    alignment: end;
                    PillButton {
                        label: "← Back";
                        clicked => { root.wizard-back(); }
                    }
                    PillButton {
                        label: "Save";
                        bg-color: Theme.accent;
                        fg-color: Theme.bg;
                        clicked => { root.wizard-save(); }
                    }
                }
            }
        }
    }
}

component AddIdeDialog inherits Rectangle {
    in-out property <string> selected;
    callback save();
    callback dismiss();

    ModalShell {
        title: "Add IDE";
        dismiss => { root.dismiss(); }

        VerticalLayout {
            spacing: Theme.gap-sm;
            Text {
                text: "Generate a new 8-char IDE key and auto-write the MCP config for:";
                color: Theme.text-secondary;
                font-size: Theme.font-body-sm;
                wrap: word-wrap;
            }
            for ide in ["Claude Code", "Cursor", "VsCodeCopilot", "OpenCode", "OpenClaude"] : Rectangle {
                background: root.selected == ide ? Theme.surface-2 : Theme.surface;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: root.selected == ide ? Theme.accent : Theme.border;
                height: 40px;
                HorizontalLayout {
                    padding-left: Theme.gap-md;
                    padding-right: Theme.gap-md;
                    alignment: start;
                    Text {
                        text: ide;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.selected = ide; }
                }
            }
            HorizontalLayout {
                spacing: Theme.gap-sm;
                alignment: end;
                PillButton {
                    label: "Generate + Write";
                    bg-color: Theme.accent;
                    fg-color: Theme.bg;
                    clicked => { root.save(); }
                }
            }
        }
    }
}

// ----- Root window -----

export component MainWindow inherits Window {
    title: "MCP Router";
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.bg;

    in property <[ApprovalRow]> approvals;
    in property <[ServerRow]> servers;
    in property <[IdeRow]> ides;
    in property <[PolicyRow]> policies;
    in property <[AuditRow]> audit;
    in property <SettingsRow> settings;
    in property <string> status-message: "ready";
    in property <bool> daemon-healthy: true;

    in property <[SkillRow]> skills;
    in property <[SkillRepoRow]> skill-repos;
    in-out property <string> skills-status-message;
    in-out property <bool> skills-busy;
    in-out property <string> skills-repo-add-owner;
    in-out property <string> skills-repo-add-name;
    in-out property <string> skills-repo-add-branch: "main";

    in-out property <int> active-tab: 0;
    in-out property <string> focused-approval: "";
    in-out property <bool> show-add-server-dialog: false;
    in-out property <bool> show-add-ide-dialog: false;
    in-out property <bool> show-delete-server-confirm: false;
    in-out property <string> pending-delete-server: "";

    // Servers tab master-detail state
    in-out property <string> selected-server: "";
    in property <ServerDetail> selected-server-detail;
    in property <[ToolPolicyRow]> selected-server-tools;

    // Add Server wizard state — 1=connection form, 2=probing, 3=per-tool policy
    in-out property <int> wizard-step: 1;
    in-out property <string> wizard-phase-status;
    in property <[ToolPolicyRow]> wizard-tools;

    in-out property <string> add-server-status;
    in-out property <bool> add-server-status-is-error: false;
    in-out property <bool> add-server-busy: false;
    in-out property <string> add-server-name;
    in-out property <string> add-server-command;
    in-out property <string> add-server-args;
    in-out property <string> add-server-url;
    in-out property <string> add-server-transport: "http";
    in-out property <string> add-server-paste;
    in-out property <string> add-server-headers;
    in-out property <string> wizard-oauth-url;

    in-out property <string> add-ide-selected: "Cursor";

    in-out property <bool> open-window-at-startup;
    in-out property <string> default-unknown-tool-policy: "ask";

    callback approve-clicked(string);
    callback deny-clicked(string);
    callback remove-server-clicked(string);
    callback remove-ide-clicked(string);
    callback change-policy(string, string, string);
    callback refresh-clicked();
    callback start-probe();                 // wizard step 1 → step 2
    callback wizard-save();                 // wizard step 3 Save (commits with current policies)
    callback wizard-back-to-form();         // step 2/3 Back button
    callback wizard-change-tool-policy(string, string);   // tool, decision
    callback select-server(string);
    callback retest-clicked(string);
    callback change-tool-policy(string, string, string);
    callback submit-add-ide();             // reads add-ide-selected
    callback parse-paste();                // reads add-server-paste, fills the other add-server-* fields
    callback toggle-open-window-at-startup(bool);
    callback set-default-unknown-tool-policy(string);
    callback copy-error-clicked(string);

    callback skills-refresh-clicked();
    callback skills-open-folder-clicked();
    callback skills-install-clicked(string, string, string, string, string, string);
    callback skills-uninstall-clicked(string);
    callback skills-toggle-target(string, string, bool);
    callback skills-add-repo(string, string, string);
    callback skills-remove-repo(string, string);
    callback skills-toggle-repo(string, string, bool);

    public function show-add-server() {
        root.show-add-server-dialog = true;
        root.wizard-step = 1;
        root.add-server-transport = "http";
        root.add-server-name = "";
        root.add-server-command = "";
        root.add-server-args = "";
        root.add-server-url = "";
        root.add-server-headers = "";
        root.add-server-paste = "";
        root.add-server-status = "";
        root.add-server-status-is-error = false;
        root.add-server-busy = false;
        root.wizard-phase-status = "";
        root.wizard-oauth-url = "";
    }

    public function show-add-ide() {
        root.show-add-ide-dialog = true;
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Header
        Rectangle {
            background: Theme.surface;
            height: 56px;
            HorizontalLayout {
                padding-left: Theme.gap-md;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-md;
                alignment: space-between;
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    alignment: center;
                    Rectangle {
                        background: Theme.accent;
                        border-radius: 4px;
                        width: 12px;
                        height: 12px;
                    }
                    Text {
                        text: "MCP ROUTER";
                        color: Theme.text-primary;
                        font-size: Theme.font-body-lg;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    alignment: center;
                    StatusDot { tint: root.daemon-healthy ? Theme.success : Theme.warning; }
                    Text {
                        text: root.status-message;
                        color: Theme.text-secondary;
                        font-size: Theme.font-body-sm;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Tab strip
        Rectangle {
            background: Theme.surface;
            height: 48px;
            HorizontalLayout {
                padding-left: Theme.gap-md;
                padding-right: Theme.gap-md;
                spacing: 4px;
                alignment: start;
                for label[i] in ["Approvals", "Servers", "Editors", "Skills", "Log", "Settings", "Help"] : TabButton {
                    label: label;
                    active: root.active-tab == i;
                    badge: i == 0 ? root.approvals.length : 0;
                    clicked => {
                        root.active-tab = i;
                        root.focused-approval = "";
                    }
                }
            }
        }

        // Content — see below; dialog overlays come after the layout.
        Rectangle {
            background: Theme.bg;
            vertical-stretch: 1;
            VerticalLayout {
                padding: Theme.gap-lg;
                alignment: start;
                if root.active-tab == 0 : ApprovalsTab {
                    rows: root.approvals;
                    focused-id: root.focused-approval;
                    approve-clicked(id) => { root.approve-clicked(id); }
                    deny-clicked(id) => { root.deny-clicked(id); }
                }
                if root.active-tab == 1 : ServersTab {
                    rows: root.servers;
                    selected: root.selected-server;
                    detail: root.selected-server-detail;
                    tools: root.selected-server-tools;
                    select-server(name) => { root.select-server(name); }
                    delete-clicked(name) => {
                        root.pending-delete-server = name;
                        root.show-delete-server-confirm = true;
                    }
                    retest-clicked(name) => { root.retest-clicked(name); }
                    change-tool-policy(server, tool, decision) => {
                        root.change-tool-policy(server, tool, decision);
                    }
                    copy-error-clicked(text) => { root.copy-error-clicked(text); }
                    add-clicked => { root.show-add-server(); }
                }
                if root.active-tab == 2 : EditorsTab {
                    rows: root.ides;
                    remove-clicked(name) => { root.remove-ide-clicked(name); }
                    add-clicked => { root.show-add-ide(); }
                }
                if root.active-tab == 3 : SkillsTab {
                    vertical-stretch: 1;
                    rows: root.skills;
                    repos: root.skill-repos;
                    status-message: root.skills-status-message;
                    busy: root.skills-busy;
                    repo-add-owner <=> root.skills-repo-add-owner;
                    repo-add-name <=> root.skills-repo-add-name;
                    repo-add-branch <=> root.skills-repo-add-branch;
                    refresh-clicked => { root.skills-refresh-clicked(); }
                    open-folder-clicked => { root.skills-open-folder-clicked(); }
                    install-clicked(owner, name, branch, dir, readme, candidate-name) => {
                        root.skills-install-clicked(owner, name, branch, dir, readme, candidate-name);
                    }
                    uninstall-clicked(directory) => { root.skills-uninstall-clicked(directory); }
                    toggle-target(directory, ide, enable) => {
                        root.skills-toggle-target(directory, ide, enable);
                    }
                    add-repo-clicked(owner, name, branch) => {
                        root.skills-add-repo(owner, name, branch);
                    }
                    remove-repo-clicked(owner, name) => { root.skills-remove-repo(owner, name); }
                    toggle-repo-clicked(owner, name, enabled) => {
                        root.skills-toggle-repo(owner, name, enabled);
                    }
                }
                if root.active-tab == 4 : LogTab {
                    rows: root.audit;
                }
                if root.active-tab == 5 : SettingsTab {
                    data: root.settings;
                    open-window-at-startup: root.open-window-at-startup;
                    default-unknown-tool-policy: root.default-unknown-tool-policy;
                    toggle-open-window(v) => { root.toggle-open-window-at-startup(v); }
                    set-default-policy(p) => { root.set-default-unknown-tool-policy(p); }
                }
                if root.active-tab == 6 : HelpTab {}
            }
        }
    }

    // Modal dialog overlays — sit on top of everything when shown.
    if root.show-add-server-dialog : AddServerDialog {
        width: root.width;
        height: root.height;
        name <=> root.add-server-name;
        command <=> root.add-server-command;
        args <=> root.add-server-args;
        url <=> root.add-server-url;
        headers <=> root.add-server-headers;
        transport <=> root.add-server-transport;
        paste <=> root.add-server-paste;
        status <=> root.add-server-status;
        status-is-error <=> root.add-server-status-is-error;
        busy <=> root.add-server-busy;
        step: root.wizard-step;
        phase-status: root.wizard-phase-status;
        oauth-url: root.wizard-oauth-url;
        tools: root.wizard-tools;
        start-probe => { root.start-probe(); }
        wizard-save => { root.wizard-save(); }
        wizard-back => { root.wizard-back-to-form(); }
        change-tool-policy(tool, decision) => {
            root.wizard-change-tool-policy(tool, decision);
        }
        copy-oauth-url => { root.copy-error-clicked(root.wizard-oauth-url); }
        dismiss => {
            root.show-add-server-dialog = false;
            root.add-server-status = "";
            root.wizard-step = 1;
        }
        parse => { root.parse-paste(); }
    }
    if root.show-delete-server-confirm : ModalShell {
        title: "Remove server?";
        dismiss => {
            root.show-delete-server-confirm = false;
            root.pending-delete-server = "";
        }
        VerticalLayout {
            spacing: Theme.gap-md;
            Text {
                text: "Removing \"" + root.pending-delete-server + "\" also strips its entries from every IDE config we wrote.";
                color: Theme.text-secondary;
                font-size: Theme.font-body-sm;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.gap-sm;
                alignment: end;
                PillButton {
                    label: "Cancel";
                    clicked => {
                        root.show-delete-server-confirm = false;
                        root.pending-delete-server = "";
                    }
                }
                PillButton {
                    label: "Remove";
                    bg-color: Theme.danger;
                    fg-color: Theme.bg;
                    clicked => {
                        root.remove-server-clicked(root.pending-delete-server);
                        root.show-delete-server-confirm = false;
                        root.pending-delete-server = "";
                    }
                }
            }
        }
    }
    if root.show-add-ide-dialog : AddIdeDialog {
        width: root.width;
        height: root.height;
        selected <=> root.add-ide-selected;
        save => { root.submit-add-ide(); root.show-add-ide-dialog = false; }
        dismiss => { root.show-add-ide-dialog = false; }
    }
}
