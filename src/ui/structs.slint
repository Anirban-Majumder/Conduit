// Data structs shared across the UI and the Rust GUI glue.
// Each `export struct` here becomes a generated Rust type the daemon fills in
// and pushes to the window. main.slint re-exports these; the tabs import the
// specific rows they render. Markup-only helper components live in components/.

export struct ApprovalRow {
    id: string,
    ide_name: string,
    server: string,
    tool: string,
    created_at: string,
    args_json: string,
}

export struct EnvVarRow {
    key: string,
    value: string,
}

export struct DashboardStats {
    server_count: int,
    server_live: int,
    server_auth_failures: int,
    skill_count: int,
    editor_count: int,
    calls_24h: int,
    denied_24h: int,
}

export struct ServerRow {
    name: string,
    transport: string,
    lifecycle_label: string,    // "persistent" / "ephemeral" / "300s idle"
    status: string,             // "running" | "idle" | "crashed"
    tool_count_label: string,
    auth_failure: bool,
}

export struct IdeRow {
    kind: string,
    display_name: string,
    key: string,
    status: string,
    config_path: string,
    icon: image,
}

// Per-IDE brand icons, sourced from each client module's `ICON_SVG` and set
// once by the Rust glue. Tabs bind these instead of hardcoding asset paths, so
// adding an IDE touches no `.slint`. Editors-tab list rows carry their own
// per-row `IdeRow.icon`; this global serves the fixed toggle sets (e.g. Skills).
export global IdeIcons {
    in property <image> claude-code;
    in property <image> openclaude;
    in property <image> opencode;
    in property <image> cursor;
    in property <image> vscode-copilot;
    in property <image> codex;
}

export struct PolicyRow {
    server: string,
    tool: string,
    decision: string,           // "allow" | "deny" | "ask"
    source: string,
}

export struct ToolPolicyRow {
    name: string,
    description: string,
    decision: string,           // "allow" | "ask" | "deny"
}

export struct ServerIdeTarget {
    ide_kind: string,
    label: string,
    active: bool,
}

export struct ServerDetail {
    name: string,
    version: string,                // "server_version" from probe
    transport: string,              // "stdio" | "http"
    command_or_url: string,
    lifecycle_label: string,
    health_state: string,           // "live" | "idle" | "down" | "unprobed" | "needsauth" | "paused"
    last_probe_label: string,       // "2m ago" or "never"
    last_error: string,             // empty if no error
    tool_count_label: string,       // "12 tools"
    auth_failure_msg: string,       // empty if no auth failure
    latency_label: string,          // "14ms" init duration, empty if unknown
}


export struct AuditRow {
    ts_label: string,
    ide_name: string,
    server: string,
    tool: string,
    decision: string,
    latency_label: string,
}

export struct SettingsRow {
    port: string,
    approval_timeout: string,
    default_lifecycle: string,
    audit_retention: string,
    theme: string,
    autostart_at_login: string,
    notifications_enabled: string,
}

export struct SkillRow {
    key: string,
    directory: string,
    name: string,
    description: string,
    repo_label: string,
    repo_owner: string,
    repo_name: string,
    repo_branch: string,
    source_directory: string,
    readme_url: string,
    installed: bool,
    target_claude: bool,
    target_openclaude: bool,
    target_opencode: bool,
    target_cursor: bool,
    target_vscode_copilot: bool,
    target_codex: bool,
}

export struct SkillRepoRow {
    owner: string,
    name: string,
    branch: string,
    enabled: bool,
}
